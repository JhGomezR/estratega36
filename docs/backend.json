{
  "entities": {
    "Campaign": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campaign",
      "type": "object",
      "description": "Represents a political campaign.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the campaign."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the campaign."
        },
        "campaignType": {
          "type": "string",
          "description": "The type of campaign (e.g., 'presidencia', 'alcaldia')."
        },
        "goal": {
          "type": "string",
          "description": "The primary goal of the campaign."
        },
        "startDate": {
          "type": "string",
          "description": "Start date of the campaign.",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "description": "End date of the campaign.",
          "format": "date"
        },
        "hasInvestors": {
          "type": "boolean"
        },
        "investors": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Investor"
          }
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed", "planned"]
        },
        "progress": {
            "type": "number"
        }
      },
      "required": [
        "name",
        "description",
        "campaignType",
        "goal",
        "startDate",
        "endDate",
        "status",
        "progress"
      ]
    },
    "Investor": {
        "title": "Investor",
        "type": "object",
        "properties": {
            "firstName": {"type": "string"},
            "lastName": {"type": "string"},
            "description": {"type": "string"},
            "investmentAmount": {"type": "number"}
        },
        "required": ["firstName", "lastName", "investmentAmount"]
    },
    "Voter": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Voter",
      "type": "object",
      "description": "Represents a registered voter.",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "idType": {
            "type": "string"
        },
        "idNumber": {
            "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "cityId": {
          "type": "string"
        },
        "vereda": {
            "type": "string"
        },
        "promoterId": {
          "type": "string"
        },
        "registrationDate": {
            "type": "string",
            "format": "date"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "idType",
        "idNumber",
        "address",
        "cityId",
        "vereda",
        "promoterId",
        "registrationDate"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
         "idType": {
            "type": "string"
        },
        "idNumber": {
            "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
            "type": "string"
        },
        "roleId": {
          "type": "string"
        },
        "cityIds": {
            "type": "array",
            "items": {"type": "string"}
        },
        "campaignIds": {
            "type": "array",
            "items": {"type": "string"}
        },
        "avatar": {
            "type": "string",
            "format": "uri"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email",
        "roleId",
        "cityIds",
        "campaignIds"
      ]
    },
    "Role": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Role",
      "type": "object",
      "description": "Represents a role within the application.",
      "properties": {
        "name": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "manage_users",
              "manage_campaigns",
              "view_all_data",
              "manage_settings",
              "manage_promoters",
              "register_voters",
              "view_own_data",
              "manage_roles"
            ]
          }
        }
      },
      "required": [
        "name",
        "permissions"
      ]
    },
    "City": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "City",
      "type": "object",
      "description": "Represents a city.",
      "properties": {
        "name": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "latitude": {
            "type": "number"
        },
        "longitude": {
            "type": "number"
        }
      },
      "required": [
        "name",
        "department",
        "country",
        "latitude",
        "longitude"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "/roles/{roleId}": {
      "schema": {
        "$ref": "#/entities/Role"
      },
      "description": "Stores role definitions, with specific roles for 'admin', 'campaign_manager', and 'promoter'."
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Stores campaign information."
    },
    "/voters/{voterId}": {
      "schema": {
        "$ref": "#/entities/Voter"
      },
      "description": "Stores voter information."
    },
    "/cities/{cityId}": {
      "schema": {
        "$ref": "#/entities/City"
      },
      "description": "Stores city information."
    }
  }
}
