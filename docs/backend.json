
{
  "entities": {
    "Campaign": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campaign",
      "type": "object",
      "description": "Represents a political campaign.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the campaign."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the campaign."
        },
        "campaignType": {
          "type": "string",
          "description": "The type of campaign (e.g., 'presidencia', 'alcaldia')."
        },
        "goal": {
          "type": "string",
          "description": "The primary goal of the campaign."
        },
        "startDate": {
          "type": "string",
          "description": "Start date of the campaign.",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "description": "End date of the campaign.",
          "format": "date"
        },
        "hasInvestors": {
          "type": "boolean"
        },
        "investors": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Investor"
          }
        },
        "status": {
          "type": "string",
          "description": "The status of the campaign, e.g., 'Futura', 'En Campaña', 'Finalizada', 'Archivada'."
        },
        "progress": {
            "type": "number"
        }
      },
      "required": [
        "name",
        "description",
        "campaignType",
        "goal",
        "startDate",
        "endDate",
        "status",
        "progress"
      ]
    },
    "Investor": {
        "title": "Investor",
        "type": "object",
        "properties": {
            "firstName": {"type": "string"},
            "lastName": {"type": "string"},
            "description": {"type": "string"},
            "investmentAmount": {"type": "number"}
        },
        "required": ["firstName", "lastName", "investmentAmount"]
    },
    "Voter": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Voter",
      "type": "object",
      "description": "Represents a registered voter.",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "idType": {
            "type": "string"
        },
        "idNumber": {
            "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "cityId": {
          "type": "string"
        },
        "vereda": {
            "type": "string"
        },
        "promoterId": {
          "type": "string"
        },
        "registrationDate": {
            "type": "string",
            "format": "date"
        },
        "latitude": {
            "type": "number"
        },
        "longitude": {
            "type": "number"
        },
        "status": {
          "type": "string",
          "description": "The status of the voter, e.g., 'activo', 'inactivo'.",
          "default": "activo"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "idType",
        "idNumber",
        "address",
        "cityId",
        "vereda",
        "promoterId",
        "registrationDate",
        "status"
      ]
    },
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a task for a campaign.",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "assignedToId": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "priority": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "The status of the task, e.g., 'pendiente', 'en_curso', 'finalizada', 'archivada'."
        }
      },
      "required": ["title", "assignedToId", "startDate", "dueDate", "priority", "status"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
         "idType": {
            "type": "string"
        },
        "idNumber": {
            "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "username": {
            "type": "string"
        },
        "password": {
            "type": "string"
        },
        "phone": {
            "type": "string"
        },
        "roleId": {
          "type": "string"
        },
        "cityIds": {
            "type": "array",
            "items": {"type": "string"}
        },
        "campaignIds": {
            "type": "array",
            "items": {"type": "string"}
        },
        "avatar": {
            "type": "string",
            "format": "uri"
        },
        "status": {
          "type": "string",
          "description": "The status of the user, e.g., 'activo', 'inactivo'.",
          "default": "activo"
        },
        "parentId": {
            "type": "string",
            "description": "The ID of the user who registered this user, establishing the hierarchy."
        }
      },
      "required": [
        "firstName",
        "lastName",
        "email",
        "password",
        "roleId",
        "cityIds",
        "campaignIds",
        "status"
      ]
    },
    "Role": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Role",
      "type": "object",
      "description": "Represents a role within the application.",
      "properties": {
        "name": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "campaign:create", "campaign:read", "campaign:update", "campaign:delete",
              "voter:create", "voter:read", "voter:update", "voter:delete",
              "user:create", "user:read", "user:update", "user:delete",
              "role:create", "role:read", "role:update", "role:delete",
              "city:create", "city:read", "city:update", "city:delete",
              "task:create", "task:read", "task:update", "task:delete",
              "call:create", "call:read", "call:update", "call:delete",
              "report:read",
              "setting:update"
            ]
          }
        },
        "status": {
          "type": "string",
          "description": "The status of the role, e.g., 'activo', 'inactivo'.",
          "default": "activo"
        }
      },
      "required": [
        "name",
        "permissions",
        "status"
      ]
    },
    "City": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "City",
      "type": "object",
      "description": "Represents a city.",
      "properties": {
        "name": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "latitude": {
            "type": "number"
        },
        "longitude": {
            "type": "number"
        },
        "status": {
          "type": "string",
          "description": "The status of the city, e.g., 'activo', 'inactivo'.",
          "default": "activo"
        }
      },
      "required": [
        "name",
        "department",
        "country",
        "latitude",
        "longitude",
        "status"
      ]
    },
    "Call": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Call",
      "type": "object",
      "description": "Represents a call to a voter.",
      "properties": {
        "voterId": {
          "type": "string",
          "description": "The ID of the voter to be called."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who made the call."
        },
        "status": {
          "type": "string",
          "description": "The status of the call."
        },
        "callDate": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the call was attended."
        },
        "attempts": {
          "type": "number",
          "description": "Number of attempts made to call the voter."
        },
        "details": {
            "type": "string",
            "description": "Details or notes from the call."
        }
      },
      "required": ["voterId", "status", "attempts"]
    },
    "BrandingSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BrandingSettings",
      "type": "object",
      "description": "Stores application-wide branding settings.",
      "properties": {
        "primaryColor": { "type": "string", "description": "Primary color for the theme." },
        "accentColor": { "type": "string", "description": "Accent color for the theme." },
        "sidebarColor": { "type": "string", "description": "Background color for the sidebar." },
        "logoUrl": { "type": "string", "format": "uri", "description": "URL for the campaign logo." }
      }
    },
    "ManagedList": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ManagedList",
        "type": "object",
        "description": "Represents a list of items managed by the user.",
        "properties": {
            "name": { "type": "string", "description": "The name of the list." },
            "items": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name", "items"]
    },
     "GeneratedStrategy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GeneratedStrategy",
      "type": "object",
      "description": "Stores an AI-generated campaign strategy.",
      "properties": {
        "campaignId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "inputs": {
          "type": "object",
          "properties": {
            "campaignData": { "type": "string" },
            "lugar": { "type": "string" },
            "objectives": { "type": "string" },
            "resourceConstraints": { "type": "string" }
          },
          "required": ["campaignData", "lugar", "objectives"]
        },
        "outputs": {
          "type": "object",
          "properties": {
            "diagnostico": { "type": "string" },
            "marca": { "type": "string" },
            "audiencia": { "type": "string" },
            "operacion": { "type": "string" },
            "consistencia": { "type": "string" },
            "microtargeting": { "type": "string" },
            "recomendaciones": { "type": "string" },
            "riesgos": { "type": "string" }
          },
          "required": ["diagnostico", "marca", "audiencia", "operacion", "consistencia", "microtargeting", "recomendaciones", "riesgos"]
        }
      },
      "required": ["campaignId", "generatedAt", "inputs", "outputs"]
    },
    "Keyword": {
        "title": "Keyword",
        "type": "object",
        "description": "A keyword or hashtag to monitor on social media.",
        "properties": {
            "keyword": { "type": "string", "description": "The keyword or hashtag to track (e.g., 'Juan Perez', '#CambioSeguro')." },
            "source": { "type": "string", "enum": ["facebook", "twitter", "instagram"], "description": "The social media platform to monitor." },
            "status": { "type": "string", "enum": ["active", "paused"], "default": "active" }
        },
        "required": ["keyword", "source", "status"]
    },
    "SocialMention": {
        "title": "SocialMention",
        "type": "object",
        "description": "A captured social media mention related to a tracked keyword.",
        "properties": {
            "keywordId": { "type": "string" },
            "source": { "type": "string", "enum": ["facebook", "twitter", "instagram"] },
            "content": { "type": "string", "description": "The full text content of the post or comment." },
            "author": { "type": "string", "description": "The username or ID of the person who made the mention." },
            "url": { "type": "string", "format": "uri", "description": "Direct link to the mention." },
            "timestamp": { "type": "string", "format": "date-time" },
            "sentiment": { "type": "string", "enum": ["positive", "negative", "neutral", "unprocessed"], "default": "unprocessed" },
            "latitude": { "type": "number", "description": "Geographical latitude, if available." },
            "longitude": { "type": "number", "description": "Geographical longitude, if available." }
        },
        "required": ["keywordId", "source", "content", "author", "url", "timestamp"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "/roles/{roleId}": {
      "schema": {
        "$ref": "#/entities/Role"
      },
      "description": "Stores role definitions, with specific roles for 'admin', 'campaign_manager', and 'promoter'."
    },
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Stores campaign information."
    },
     "/campaigns/{campaignId}/generatedStrategies/{strategyId}": {
      "schema": {
        "$ref": "#/entities/GeneratedStrategy"
      },
      "description": "Stores AI-generated strategies for a specific campaign."
    },
    "/voters/{voterId}": {
      "schema": {
        "$ref": "#/entities/Voter"
      },
      "description": "Stores voter information."
    },
    "/cities/{cityId}": {
      "schema": {
        "$ref": "#/entities/City"
      },
      "description": "Stores city information."
    },
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Stores campaign tasks."
    },
     "/calls/{callId}": {
      "schema": {
        "$ref": "#/entities/Call"
      },
      "description": "Stores call records for voters."
    },
    "/settings/branding": {
      "schema": {
        "$ref": "#/entities/BrandingSettings"
      },
      "description": "Stores the single document for application branding settings."
    },
    "/lists/{listId}": {
      "schema": {
        "$ref": "#/entities/ManagedList"
      },
      "description": "Stores documents for user-managed lists. The document ID is the list name (e.g., 'taskPriorities')."
    },
    "/keywords/{keywordId}": {
        "schema": { "$ref": "#/entities/Keyword" },
        "description": "Stores keywords to be monitored by the social listening module."
    },
    "/socialMentions/{mentionId}": {
        "schema": { "$ref": "#/entities/SocialMention" },
        "description": "Stores mentions captured from social media."
    }
  }
}
