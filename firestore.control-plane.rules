rules_version = '2';

// =====================================================================
// CONTROL PLANE ruleset — se despliega a la base `(default)`.
//
// Contiene SOLO datos de plataforma: registro de tenants, usuarios y roles
// de plataforma, estadísticas y auditoría. Los datos de negocio de cada
// tenant viven en su propia base nombrada (ver firestore.tenant.rules).
//
// Autorización por custom claim `platformAdmin`.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // token.get(clave, defecto): leer un claim ausente directamente es un ERROR
    // de evaluación, no `false`, y dejaría la autorización dependiendo del orden
    // de evaluación de los `||`.
    function isPlatformAdmin() {
      return request.auth != null && request.auth.token.get('platformAdmin', false) == true;
    }

    function callerTenantId() {
      return request.auth.token.get('tenantId', '');
    }

    // Registro de tenants. Un usuario puede LEER el documento de su propio
    // tenant (para resolver databaseId / status / branding tras el login).
    match /tenants/{tenantId} {
      allow get:    if isPlatformAdmin() || (request.auth != null && callerTenantId() == tenantId);
      allow list:   if isPlatformAdmin();
      allow create, update, delete: if isPlatformAdmin();
    }

    match /platformUsers/{uid} {
      allow read:   if isPlatformAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write:  if isPlatformAdmin();
    }

    match /platformRoles/{roleId} {
      allow read, write: if isPlatformAdmin();
    }

    match /platformStats/{document=**} {
      allow read:  if isPlatformAdmin();
      allow write: if false; // sólo escrito por backend/jobs vía Admin SDK
    }

    match /plans/{planId} {
      allow read, write: if isPlatformAdmin();
    }

    // Notificaciones del sistema (FUENTE ÚNICA). El operador de plataforma tiene
    // gestión total; los tenants SOLO pueden leer las difusiones ('all') o las
    // dirigidas a su propio tenant. Las consultas del tenant usan un único
    // filtro de igualdad (audience=='all' o tenantId==<suyo>), de modo que cada
    // documento devuelto satisface la condición de lectura.
    match /notifications/{notifId} {
      allow read, write: if isPlatformAdmin();
      allow read: if request.auth != null &&
        (resource.data.audience == 'all' || resource.data.tenantId == callerTenantId());
    }

    // Acuses de lectura de notificaciones, POR USUARIO. Cada quien crea/lee los
    // suyos (userId == su uid); el operador de plataforma puede verlos todos.
    match /notificationReads/{id} {
      allow read, write:    if isPlatformAdmin();
      allow read:           if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow read:           if isPlatformAdmin();
      allow create:         if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }
  }
}
