/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure-by-default posture, restricting data access based on user roles and explicit ownership.
 * It leverages denormalization to streamline authorization checks and improve performance. Data shape validation is relaxed to facilitate rapid prototyping.
 *
 * Data Structure:
 * - Users: Stored under `/users/{userId}`, accessible only to the owning user.
 * - Roles: Stored under `/roles/{roleId}`, intended for admin management (not directly implemented in this ruleset).
 * - Campaigns, Voters, Cities, Tasks, and Calls: Top-level collections with open reads, but with restricted write access based on explicit ownership or admin roles.
 * - Settings: Stored in a single document at `/settings/app`, write-protected.
 *
 * Key Security Decisions:
 * - User listing is disabled.
 * - Write access to Campaigns, Voters, Cities, Tasks, and Calls requires validation of an owner ID field.
 * - The Settings document is read-only for non-admins.
 *
 * Denormalization for Authorization:
 * - Documents in top-level collections (Campaigns, Voters, Cities, Tasks, Calls) MUST include a field indicating the owner (e.g., `creatorId`, `ownerId`, `authorId`). This field is validated on `create` and used for authorization on `update` and `delete`.
 *
 * Structural Segregation:
 * - No explicit segregation is used in this version. Drafts vs. published content would ideally be separated into distinct collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
    /**
     * @description Enforces user-only access to their profile data.
     * @path /users/{userId}
     * @allow (create) - User 'abc' can create their own profile if authenticated as 'abc'.
     * @allow (get, list, update, delete) - User 'abc' can read, update, or delete their profile if authenticated as 'abc'.
     * @deny (create) - User 'def' cannot create a profile with ID 'abc'.
     * @deny (update, delete) - User 'def' cannot update or delete user 'abc' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Restricts access to role definitions.  In a full implementation, only admins should manage roles.
     * @path /roles/{roleId}
     * @allow None at this stage.
     * @principle Placeholder for role-based access control.  This will need to be fleshed out with admin role checks.
     */
    match /roles/{roleId} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows public reading of campaigns, but restricts modifications to the campaign owner.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Any user (or no user) can read campaign details.
     * @allow (create) - User 'abc' can create a campaign if request.auth.uid matches request.resource.data.creatorId.
     * @allow (update, delete) - User 'abc' can update/delete a campaign only if they are the owner (resource.data.creatorId == request.auth.uid) and the document exists.
     * @deny (create) - User 'abc' cannot create a campaign with creatorId not equals to request.auth.uid.
     * @deny (update, delete) - User 'def' cannot update/delete campaign owned by 'abc'.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
    }

    /**
     * @description Allows public reading of voter information, but restricts modifications to authorized users.
     * @path /voters/{voterId}
     * @allow (get, list) - Any user can read voter information.
     * @allow (create) - User 'abc' can create a voter if request.auth.uid matches request.resource.data.creatorId.
     * @allow (update, delete) - User 'abc' can update/delete a voter record only if they are the owner and the document exists.
     * @deny (create) - User 'abc' cannot create a voter with creatorId not equals to request.auth.uid.
     * @deny (update, delete) - User 'def' cannot update/delete voter owned by 'abc'.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
    }

    /**
     * @description Allows public reading of city information, but restricts modifications to authorized users.
     * @path /cities/{cityId}
     * @allow (get, list) - Any user can read city information.
     * @allow (create) - User 'abc' can create a city if request.auth.uid matches request.resource.data.creatorId.
     * @allow (update, delete) - User 'abc' can update/delete a city record only if they are the owner and the document exists.
     * @deny (create) - User 'abc' cannot create a city with creatorId not equals to request.auth.uid.
     * @deny (update, delete) - User 'def' cannot update/delete city owned by 'abc'.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
    }

    /**
     * @description Allows public reading of task information, but restricts modifications to authorized users.
     * @path /tasks/{taskId}
     * @allow (get, list) - Any user can read task information.
     * @allow (create) - User 'abc' can create a task if request.auth.uid matches request.resource.data.creatorId.
     * @allow (update, delete) - User 'abc' can update/delete a task record only if they are the owner and the document exists.
     * @deny (create) - User 'abc' cannot create a task with creatorId not equals to request.auth.uid.
     * @deny (update, delete) - User 'def' cannot update/delete task owned by 'abc'.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
    }

    /**
     * @description Allows public reading of call information, but restricts modifications to authorized users.
     * @path /calls/{callId}
     * @allow (get, list) - Any user can read call information.
     * @allow (create) - User 'abc' can create a call if request.auth.uid matches request.resource.data.creatorId.
     * @allow (update, delete) - User 'abc' can update/delete a call record only if they are the owner and the document exists.
     * @deny (create) - User 'abc' cannot create a call with creatorId not equals to request.auth.uid.
     * @deny (update, delete) - User 'def' cannot update/delete call owned by 'abc'.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid && resource != null;
    }

    /**
     * @description Restricts write access to the settings document.
     * @path /settings/app
     * @allow (get) - Anyone can read the settings.
     * @deny (create, update, delete) - No one can create, update, or delete the settings.
     * @principle Settings are read-only in this prototype.
     */
    match /settings/app {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}