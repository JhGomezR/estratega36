/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a role-based access control model.
 *   Users can only create, update, or delete roles.
 * @data_structure
 *   - /users/{userId}: Stores user profiles. Access is restricted to the owner of the profile.
 *   - /roles/{roleId}: Stores role definitions. Only authenticated users can manage roles.
 *   - /campaigns/{campaignId}: Stores campaign information. Access is public read, owner-only write.
 *   - /voters/{voterId}: Stores voter information. Access is public read, owner-only write.
 *   - /cities/{cityId}: Stores city information. Access is public read, owner-only write.
 * @key_security_decisions
 *   - Role management is open to all authenticated users, but in a real application, this should be restricted to admin roles.
 *   - Listing of users is denied to prevent data leakage.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's auth UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing resource.
     * @param {string} userId - The user ID to compare against the resource's data and the request's auth UID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user creates their own profile.
     * @allow (get, update, delete) Owner can access and modify their own profile.
     * @deny (list) Prevents listing all user profiles.
     * @deny (create, update, delete) Non-owner attempts to modify the profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.email == request.auth.token.email;
      allow update: if isExistingOwner(userId) && request.resource.data.idNumber == resource.data.idNumber;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for roles.
     * @path /roles/{roleId}
     * @allow (create, update, delete) Authenticated users can manage roles.
     * @deny (get, list) Not implemented: access to role definitions requires further definition.
     * @principle Allows authenticated users to manage roles.
     */
    match /roles/{roleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for campaigns.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Anyone can read campaign information.
     * @allow (create) Only authenticated users can create campaigns and must set the ownerId field to their UID.
     * @allow (update, delete) Only the owner of the campaign can modify or delete it.
     * @deny Non-owners cannot create, update, or delete campaigns.
     * @principle Public read, owner-only write.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for voters.
     * @path /voters/{voterId}
     * @allow (get, list) Anyone can read voter information.
     * @allow (create) Only authenticated users can create voters and must set the promoterId field to their UID.
     * @allow (update, delete) Only the owner of the voter can modify or delete it.
     * @deny Non-owners cannot create, update, or delete voters.
     * @principle Public read, owner-only write.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Rules for cities.
     * @path /cities/{cityId}
     * @allow (get, list) Anyone can read city information.
     * @allow (create) Only authenticated users can create cities.
     * @allow (update, delete) Only the owner of the city can modify or delete it.
     * @deny Non-owners cannot create, update, or delete cities.
     * @principle Public read, owner-only write.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}