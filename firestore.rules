/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of user-based and role-based access control. Users
 * can only create, read, update, and delete their own data unless they have elevated
 * privileges granted through roles. Public read access is granted to a few top-level collections.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /roles/{roleId}: Role definitions, with specific roles like 'admin', 'campaign_manager', and 'promoter'.
 * - /campaigns/{campaignId}: Campaign information, publicly readable but writable only by authorized users.
 * - /campaigns/{campaignId}/generatedStrategies/{strategyId}: AI-generated strategies for campaigns, writeable only by authorized users
 * - /voters/{voterId}: Voter information, publicly readable but writable only by authorized users.
 * - /cities/{cityId}: City information, publicly readable but writable only by authorized users.
 * - /tasks/{taskId}: Campaign tasks, publicly readable but writable only by authorized users.
 * - /calls/{callId}: Call records for voters, publicly readable but writable only by authorized users.
 * - /settings/branding: Application-wide branding settings, writable only by authorized users.
 * - /lists/{listId}: User-managed lists, accessible only to the user who created them.
 *
 * Key Security Decisions:
 * - Listing of users is explicitly denied to prevent unauthorized data access.
 * - Public read access is granted to the /campaigns, /voters, /cities, /tasks, and /calls collections to enable broad data consumption.
 * - The default security posture for ambiguous relationships is strict owner-only access.
 *
 * Denormalization for Authorization:
 *   - The data model does not currently require denormalization. Write rules will have to be modified
 *     if further role specifications require to have campaignId stored in User documents or
 *     vice versa.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User s031sQgjugYha5RcuBDeZzZnwnX2 can create their own user document.
     * @allow (get, update, delete) User s031sQgjugYha5RcuBDeZzZnwnX2 can get, update, and delete their own user document.
     * @deny (create) User s031sQgjugYha5RcuBDeZzZnwnX2 cannot create a user document with a different userId.
     * @deny (get, update, delete) User s031sQgjugYha5RcuBDeZzZnwnX2 cannot get, update or delete other users' documents.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.idNumber == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.idNumber == resource.data.idNumber;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /roles/{roleId} collection.
     * @path /roles/{roleId}
     * @allow (get, list) Any signed-in user can read roles.
     * @deny (create, update, delete) No one can create, update, or delete roles (for prototyping).
     * @principle Restricts role management.
     */
    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Rule for the /campaigns/{campaignId} collection.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read campaign information.
     * @deny (create, update, delete) No one can create, update, or delete campaigns (for prototyping).
     * @principle Public read with restricted writes (TODO: Implement role-based write access).
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rule for the /campaigns/{campaignId}/generatedStrategies/{strategyId} subcollection.
     * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
     *  @allow (get, list) Any user can read campaign strategies.
     * @deny (create, update, delete) No one can create, update, or delete strategies (for prototyping).
     * @principle Public read with restricted writes (TODO: Implement role-based write access).
     */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
       allow get, list: if true;
       allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rule for the /voters/{voterId} collection.
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read voter information.
     * @deny (create, update, delete) No one can create, update, or delete voters (for prototyping).
     * @principle Public read with restricted writes (TODO: Implement role-based write access).
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rule for the /cities/{cityId} collection.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read city information.
     * @deny (create, update, delete) No one can create, update, or delete cities (for prototyping).
     * @principle Public read with restricted writes (TODO: Implement role-based write access).
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rule for the /tasks/{taskId} collection.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can read task information.
     * @deny (create, update, delete) No one can create, update, or delete tasks (for prototyping).
     * @principle Public read with restricted writes (TODO: Implement role-based write access).
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

     /**
     * @description Rule for the /calls/{callId} collection.
     * @path /calls/{callId}
     * @allow (get, list) Any user can read call information.
     * @deny (create, update, delete) No one can create, update, or delete calls (for prototyping).
     * @principle Public read with restricted writes (TODO: Implement role-based write access).
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Rule for the /settings/branding document.
     * @path /settings/branding
     * @allow (get) Any user can read branding settings.
     * @deny (create, update, delete) No one can create, update, or delete branding settings (for prototyping).
     * @principle Restricts branding settings modification.
     */
    match /settings/branding {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Rule for the /lists/{listId} collection.
     * @path /lists/{listId}
     * @allow (get, list) Any signed-in user can read lists.
     * @deny (create, update, delete) No one can create, update, or delete lists (for prototyping).
     */
    match /lists/{listId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}