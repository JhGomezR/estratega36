/**
 * @file Firestore Security Rules
 * @description This ruleset allows any user to read, create, edit, and delete data in the Firestore database.
 *
 * Core Philosophy:
 * This ruleset disables authorization checks for prototyping purposes. All read and write operations are permitted for all users.
 *
 * Data Structure:
 * The Firestore database contains collections for users, roles, campaigns, voters, and cities. Each collection stores documents representing entities of the corresponding type.
 *
 * Key Security Decisions:
 * - All read and write operations are allowed.
 * - No authorization checks are performed.
 *
 * WARNING: This ruleset is insecure and should only be used for prototyping purposes.
 * It is highly recommended to implement proper authorization checks before deploying the application to a production environment.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any user to read, create, update, and delete user profiles.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) - Any user can perform any operation.
     * @deny None
     * @principle Open access for prototyping.
     */
    match /users/{userId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete role definitions.
     * @path /roles/{roleId}
     * @allow (get, list, create, update, delete) - Any user can perform any operation.
     * @deny None
     * @principle Open access for prototyping.
     */
    match /roles/{roleId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list, create, update, delete) - Any user can perform any operation.
     * @deny None
     * @principle Open access for prototyping.
     */
    match /campaigns/{campaignId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete voter information.
     * @path /voters/{voterId}
     * @allow (get, list, create, update, delete) - Any user can perform any operation.
     * @deny None
     * @principle Open access for prototyping.
     */
    match /voters/{voterId} {
      allow get, list, create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete city information.
     * @path /cities/{cityId}
     * @allow (get, list, create, update, delete) - Any user can perform any operation.
     * @deny None
     * @principle Open access for prototyping.
     */
    match /cities/{cityId} {
      allow get, list, create, update, delete: if true;
    }
  }
}