
/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset provides open read and write access to all documents in the database.
 *
 * Data Structure:
 * The database is organized into top-level collections for various entities.
 *
 * Key Security Decisions:
 * - All `get`, `list`, `create`, `update`, and `delete` operations are allowed for everyone.
 * - This is for rapid prototyping and MUST be secured before production use.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Generic rule to allow open access to any document.
     * This is a fallback and specific rules below are preferred for clarity.
     */
    match /{document=**} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to user profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to role definitions.
     * @path /roles/{roleId}
     */
    match /roles/{roleId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to campaign information.
     * @path /campaigns/{campaignId}
     */
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to AI-generated campaign strategies.
     * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
     */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to voter information.
     * @path /voters/{voterId}
     */
    match /voters/{voterId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to the entire geographical hierarchy.
     * @path /countries/{countryId}
     */
    match /countries/{countryId} {
        allow read, write: if true;
        
        /**
        * @description Allows access to departments within a country.
        * @path /countries/{countryId}/departments/{departmentId}
        */
        match /departments/{departmentId} {
            allow read, write: if true;

             /**
             * @description Allows access to cities within a department.
             * @path /countries/{countryId}/departments/{departmentId}/cities/{cityId}
             */
            match /cities/{cityId} {
                allow read, write: if true;
            }
        }
    }
    
    /**
     * @description Allows collection group queries on 'departments'.
     * This is necessary for querying all departments across all countries.
     */
    match /{path=**}/departments/{departmentId} {
      allow get, list: if true;
    }

    /**
     * @description Allows collection group queries on 'cities'.
     * This is necessary for querying all cities across all departments/countries.
     */
    match /{path=**}/cities/{cityId} {
      allow get, list: if true;
    }

    /**
     * @description Allows read and write access to campaign tasks.
     * @path /tasks/{taskId}
     */
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to call records for voters.
     * @path /calls/{callId}
     */
    match /calls/{callId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to application branding settings.
     * @path /settings/branding
     */
    match /settings/branding {
      allow read, write: if true;
    }

     /**
     * @description Allows read and write access to social media API settings.
     * @path /settings/socialApi
     */
    match /settings/socialApi {
        allow read, write: if true;
    }

    /**
     * @description Allows read and write access to user-managed lists.
     * @path /lists/{listId}
     */
    match /lists/{listId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to social listening keywords.
     * @path /keywords/{keywordId}
     */
    match /keywords/{keywordId} {
      allow read, write: if true;
    }

    /**
     * @description Allows read and write access to captured social media mentions.
     * @path /socialMentions/{mentionId}
     */
    match /socialMentions/{mentionId} {
      allow read, write: if true;
    }
  }
}
