/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model.  Users are assigned roles,
 * and these roles determine the permissions they have within the application. All write
 * operations are strictly controlled and based on the user's role. Read access defaults
 * to restricted unless explicitly granted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Access is restricted to the user themselves.
 * - /roles/{roleId}: Stores role definitions. Only users with the 'manage_roles' permission can manage roles.
 * - /campaigns/{campaignId}: Stores campaign information.  Access is role-based.
 * - /voters/{voterId}: Stores voter information.  Access is role-based and potentially restricted by campaign.
 * - /cities/{cityId}: Stores city information. Read access is public; write access is prohibited.
 *
 * Key Security Decisions:
 * - Listing of users is disallowed for privacy reasons.
 * - Public read access is granted to the /cities collection.
 * - Roles are directly managed in the `roles` collection, and all write operations to this collection require the `manage_roles` permission.
 *
 * Denormalization for Authorization:
 *  - The `users` collection requires each document to have a `roleId` field.  This field is used to look up the user's permissions in the `roles` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to check against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has the given permission.
     * @param {string} permission The permission to check for.
     */
    function hasPermission(permission) {
      return get(/databases/$(database)/documents/roles/$(request.auth.token.roleId)).data.permissions.hasAny([permission]);
    }

    /**
     * @description Checks if the user is the existing owner of the document.
     * @param {string} userId The user ID to check against.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) Signed-in user creates their own profile.
     * @allow (get, update, delete) Signed-in user can only access their own profile.
     * @deny (create) User attempts to create a profile with an ID that doesn't match their auth UID.
     * @deny (get, update, delete) User attempts to access another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.idNumber == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.idNumber == resource.data.idNumber;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /roles/{roleId} collection.
     * @path /roles/{roleId}
     * @allow (create, update, delete) Only users with the 'manage_roles' permission can manage roles.
     * @deny (create, update, delete) Users without the 'manage_roles' permission cannot manage roles.
     * @allow (get, list) Any signed-in user can read role definitions.
     * @principle Role-based access control for managing roles.
     */
    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && hasPermission('manage_roles');
      allow update: if isSignedIn() && hasPermission('manage_roles') && resource != null;
      allow delete: if isSignedIn() && hasPermission('manage_roles') && resource != null;
    }

    /**
     * @description Rules for the /campaigns/{campaignId} collection.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any signed-in user can view campaigns.
     * @allow (create) Only users with 'manage_campaigns' permission can create campaigns.
     * @allow (update, delete) Only users with 'manage_campaigns' permission can modify campaigns.
     * @principle Role-based access control for campaign management.
     */
    match /campaigns/{campaignId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && hasPermission('manage_campaigns');
      allow update: if isSignedIn() && hasPermission('manage_campaigns') && resource != null;
      allow delete: if isSignedIn() && hasPermission('manage_campaigns') && resource != null;
    }

    /**
     * @description Rules for the /voters/{voterId} collection.
     * @path /voters/{voterId}
     * @allow (get, list) Any signed-in user can view voters.
     * @allow (create) Only users with 'register_voters' permission can create voters.
     * @allow (update, delete) Only users with 'manage_voters' permission can manage voters.
     * @principle Role-based access control for voter management.
     */
    match /voters/{voterId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && hasPermission('register_voters');
      allow update: if isSignedIn() && hasPermission('manage_voters') && resource != null;
      allow delete: if isSignedIn() && hasPermission('manage_voters') && resource != null;
    }

    /**
     * @description Rules for the /cities/{cityId} collection.
     * @path /cities/{cityId}
     * @allow (get, list) Public read access to city information.
     * @deny (create, update, delete) No write access allowed.
     * @principle Public read access with no write access.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}