/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict ownership and role-based access control.
 * It assumes that data validation will be handled in the application code to allow for rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /roles/{roleId}: Stores role definitions.  These are intended to be publicly readable.
 * - /campaigns/{campaignId}: Stores campaign information. Read and write access is open for prototyping.
 * - /voters/{voterId}: Stores voter information.  Read and write access is open for prototyping.
 * - /cities/{cityId}: Stores city information.  These are intended to be publicly readable.
 *
 * Key Security Decisions:
 * - Users can only read/write their own user document.
 * - Listing of users is disallowed.
 * - Read access to roles and cities is public.
 * - Campaigns and Voters are open for read and writes (prototyping mode).
 *
 * Denormalization for Authorization:
 *  N/A - No specific denormalization is applied in this initial ruleset.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID and resource exists
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User 'user123' can create their profile if authenticated as 'user123'.
     * @allow (get, update, delete) User 'user123' can read, update and delete their own profile.
     * @deny (create) User 'user456' cannot create a profile with ID 'user123'.
     * @deny (get, update, delete) User 'user456' cannot read, update and delete profile 'user123'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for roles.
     * @path /roles/{roleId}
     * @allow (get, list) Any user can read the roles.
     * @deny (create, update, delete) No user can create, update, or delete roles.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for campaigns.  Open for prototyping.
     * @path /campaigns/{campaignId}
     * @allow (get, list, create, update, delete) Any user can read, write, and delete campaign data.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // Only signed in users can create campaigns
      allow update: if isSignedIn() && resource != null; // Only signed in users can update campaigns and resource must exist.
      allow delete: if isSignedIn() && resource != null; // Only signed in users can delete campaigns and resource must exist.
    }

    /**
     * @description Rules for voters. Open for prototyping.
     * @path /voters/{voterId}
     * @allow (get, list, create, update, delete) Any user can read, write, and delete voter data.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // Only signed in users can create voters
      allow update: if isSignedIn() && resource != null; // Only signed in users can update voters and resource must exist.
      allow delete: if isSignedIn() && resource != null; // Only signed in users can delete voters and resource must exist.
    }

    /**
     * @description Rules for cities.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read the cities.
     * @deny (create, update, delete) No user can create, update, or delete cities.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}