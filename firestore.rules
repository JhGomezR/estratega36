/**
 * @file Firebase Security Rules for the Votantes module.
 *
 * @corePhilosophy This ruleset allows open read and write access to all data.
 *
 * @dataStructure The database consists of top-level collections for users, roles, campaigns, voters and cities.
 *
 * @keySecurityDecisions All collections are publicly accessible for both reads and writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read and write user data.
     * @path /users/{userId}
     * @allow (get, list)
     * @allow (create, update, delete)
     * @principle Allows anyone to perform any operation
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write role data.
     * @path /roles/{roleId}
     * @allow (get, list)
     * @allow (create, update, delete)
     * @principle Allows anyone to perform any operation
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write campaign data.
     * @path /campaigns/{campaignId}
     * @allow (get, list)
     * @allow (create, update, delete)
     * @principle Allows anyone to perform any operation
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write voter data.
     * @path /voters/{voterId}
     * @allow (get, list)
     * @allow (create, update, delete)
     * @principle Allows anyone to perform any operation
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write city data.
     * @path /cities/{cityId}
     * @allow (get, list)
     * @allow (create, update, delete)
     * @principle Allows anyone to perform any operation
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}