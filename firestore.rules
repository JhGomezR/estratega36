/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset is designed for rapid prototyping. It prioritizes developer velocity by providing open read access and minimal write restrictions based on the user's request.
 *
 * Data Structure:
 * The Firestore database consists of several top-level collections: /users, /roles, /campaigns, /voters, /cities and /tasks. Each collection stores documents related to the respective entities.
 *
 * Key Security Decisions:
 * - Tasks collection:  Allows anyone to view, edit, create, and delete tasks based on the user request.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read user profiles. Only the owner can create, update, and delete their own profile.
     * @path /users/{userId}
     * @allow (get, list): Any user can read any user profile.
     * @allow (create): Authenticated user with matching {userId} can create their profile.
     * @allow (update, delete): Authenticated user with matching {userId} can update or delete their profile.
     * @deny (create): Authenticated user tries to create a profile with a mismatched {userId}.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == userId && resource != null;
    }

    /**
     * @description Allows anyone to read roles. Restricts creation, updates, and deletion of roles.
     * @path /roles/{roleId}
     * @allow (get, list): Any user can read any role.
     * @deny (create, update, delete): No one can create, update, or delete roles.
     * @principle Defines read-only access for roles.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read campaign information. Restricts creation, updates, and deletion of campaigns.
     * @path /campaigns/{campaignId}
     * @allow (get, list): Any user can read any campaign.
     * @deny (create, update, delete): No one can create, update, or delete campaigns.
     * @principle Defines read-only access for campaigns.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read voter information. Restricts creation, updates, and deletion of voters.
     * @path /voters/{voterId}
     * @allow (get, list): Any user can read any voter.
     * @deny (create, update, delete): No one can create, update, or delete voters.
     * @principle Defines read-only access for voters.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read city information. Restricts creation, updates, and deletion of cities.
     * @path /cities/{cityId}
     * @allow (get, list): Any user can read any city.
     * @deny (create, update, delete): No one can create, update, or delete cities.
     * @principle Defines read-only access for cities.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to view, edit, create, and delete tasks.
     * @path /tasks/{taskId}
     * @allow (get, list, create, update, delete): Any user can perform any operation on tasks.
     * @principle Open access for tasks based on the user request.
     */
    match /tasks/{taskId} {
      allow get, list, create, update, delete: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}