/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset provides completely open access to all data for all users.
 *
 * Data Structure:
 * The Firestore database consists of several top-level collections:
 * - /users/{userId}: User profile data.
 * - /roles/{roleId}: Role definitions.
 * - /campaigns/{campaignId}: Campaign information.
 * - /voters/{voterId}: Voter information.
 * - /cities/{cityId}: City information.
 * - /tasks/{taskId}: Campaign tasks.
 * - /calls/{callId}: Call records for voters.
 * - /settings/app: Application settings.
 *
 * Key Security Decisions:
 * - All read and write operations are allowed for all users, including unauthenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any user to read or write any user profile.
     * @path /users/{userId}
     * @allow (get, list) Any user can read any user profile.
     * @allow (create, update, delete) Any user can create, update, or delete any user profile.
     * @principle Unrestricted access to user profiles.
     */
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write any role definition.
     * @path /roles/{roleId}
     * @allow (get, list) Any user can read any role definition.
     * @allow (create, update, delete) Any user can create, update, or delete any role definition.
     * @principle Unrestricted access to role definitions.
     */
    match /roles/{roleId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write any campaign.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read any campaign.
     * @allow (create, update, delete) Any user can create, update, or delete any campaign.
     * @principle Unrestricted access to campaign information.
     */
    match /campaigns/{campaignId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write any voter.
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read any voter.
     * @allow (create, update, delete) Any user can create, update, or delete any voter.
     * @principle Unrestricted access to voter information.
     */
    match /voters/{voterId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write any city.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read any city.
     * @allow (create, update, delete) Any user can create, update, or delete any city.
     * @principle Unrestricted access to city information.
     */
    match /cities/{cityId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write any task.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can read any task.
     * @allow (create, update, delete) Any user can create, update, or delete any task.
     * @principle Unrestricted access to tasks.
     */
    match /tasks/{taskId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write any call record.
     * @path /calls/{callId}
     * @allow (get, list) Any user can read any call record.
     * @allow (create, update, delete) Any user can create, update, or delete any call record.
     * @principle Unrestricted access to call records.
     */
    match /calls/{callId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows any user to read or write application settings.
     * @path /settings/app
     * @allow (get, list) Any user can read application settings.
     * @allow (create, update, delete) Any user can create, update, or delete application settings.
     * @principle Unrestricted access to application settings.
     */
    match /settings/app {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}