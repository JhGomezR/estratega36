/**
 * @file Firestore Security Rules
 * @description This ruleset allows any read and write access to all documents in the database.
 *
 * Core Philosophy:
 * This ruleset is for PROTOTYPING ONLY and provides NO AUTHENTICATION OR AUTHORIZATION.
 * It is explicitly designed for rapid development iterations.  It is **critically insecure**
 * for production deployments.
 *
 * Data Structure:
 * The Firestore database contains collections for users, roles, campaigns, voters, cities, tasks and calls.
 *
 * Key Security Decisions:
 * - All reads and writes are allowed.
 * - No data validation is performed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any read or write to user profiles.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any read or write to roles.
     * @path /roles/{roleId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any read or write to campaigns.
     * @path /campaigns/{campaignId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any read or write to voters.
     * @path /voters/{voterId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any read or write to cities.
     * @path /cities/{cityId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any read or write to tasks.
     * @path /tasks/{taskId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any read or write to calls.
     * @path /calls/{callId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation.
     * @deny (none)
     * @principle This rule is insecure and for prototyping only.
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}