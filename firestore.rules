/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for user profiles and restricts access to other collections based on authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the authenticated user can read/write their own profile.
 * - /roles/{roleId}: Stores role definitions. Read-only for all authenticated users.
 * - /campaigns/{campaignId}: Stores campaign data. Public read, owner-only write (requires 'ownerId' field).
 * - /campaigns/{campaignId}/generatedStrategies/{strategyId}: AI-generated strategies for a campaign. Public read, owner-only write (requires 'ownerId' field on campaign).
 * - /voters/{voterId}: Stores voter information. Public read, owner-only write (requires 'ownerId' field).
 * - /cities/{cityId}: Stores city information. Public read, owner-only write (requires 'ownerId' field).
 * - /tasks/{taskId}: Stores campaign tasks. Public read, owner-only write (requires 'ownerId' field).
 * - /calls/{callId}: Stores call records for voters. Public read, owner-only write (requires 'ownerId' field).
 * - /settings/branding: Stores branding settings. Only authenticated users can read, owner only write (requires 'ownerId' field).
 * - /lists/{listId}: Stores user-managed lists. Public read, owner-only write (requires 'ownerId' field).
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Read-only collections (e.g., /roles) are explicitly marked as such.
 * - Ambiguous relationships default to strict owner-only access.
 *
 * Denormalization for Authorization:
 * - To simplify rules and improve performance, it is recommended that all documents include an explicit `ownerId` field.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Prevents listing all users in the database.
     * @path /users
     * @allow (list) - N/A
     * @deny (list) - Any authenticated user attempting to list all users.
     * @principle Prevents unauthorized enumeration of users.
     */
    match /users {
        allow list: if false;
    }

    /**
     * @description Controls access to individual user profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete) - Authenticated user accessing their own profile.
     * @deny (get, create, update, delete) - Authenticated user attempting to access another user's profile.
     * @principle Enforces user-ownership for profiles.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
      allow list: if false; // User listing is not allowed
    }

    /**
     * @description Controls access to role definitions.
     * @path /roles/{roleId}
     * @allow (get, list) - Any authenticated user can read role definitions.
     * @deny (create, update, delete) - No one can create, update, or delete roles through the client.
     * @principle Roles are read-only for clients.
     */
    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Any authenticated user can read campaign information.
     * @deny (create, update, delete) - Only the owner of the campaign can modify it.
     * @principle Allows public read, enforces owner-only writes.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to AI-generated strategies for a specific campaign.
     * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
     * @allow (get, list) - Any authenticated user can read strategies.
     * @deny (create, update, delete) - Only the owner of the campaign can modify its strategies.
     * @principle Allows public read, enforces owner-only writes based on campaign ownership.
     */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
      allow get, list: if true;
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null;  // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to voter information.
     * @path /voters/{voterId}
     * @allow (get, list) - Any authenticated user can read voter information.
     * @deny (create, update, delete) - Only the owner can modify voter data.
     * @principle Allows public read, enforces owner-only writes.
     */
    match /voters/{voterId} {
      allow get, list: if true;
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to city information.
     * @path /cities/{cityId}
     * @allow (get, list) - Any authenticated user can read city information.
     * @deny (create, update, delete) - Only the owner can modify city data.
     * @principle Allows public read, enforces owner-only writes.
     */
    match /cities/{cityId} {
      allow get, list: if true;
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to campaign tasks.
     * @path /tasks/{taskId}
     * @allow (get, list) - Any authenticated user can read task information.
     * @deny (create, update, delete) - Only the owner can modify task data.
     * @principle Allows public read, enforces owner-only writes.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null;  // TODO: Add owner validation once the schema is updated with an ownership field.
    }

     /**
      * @description Controls access to call records for voters.
      * @path /calls/{callId}
      * @allow (get, list) - Any authenticated user can read call records.
      * @deny (create, update, delete) - Only the owner can modify call records.
      * @principle Allows public read, enforces owner-only writes.
      */
    match /calls/{callId} {
      allow get, list: if true;
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to application branding settings.
     * @path /settings/branding
     * @allow (get) - Any authenticated user can read branding settings.
     * @deny (create, update, delete) - Only the owner can modify branding settings.
     */
    match /settings/branding {
      allow get, list: if isSignedIn();
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to user-managed lists.
     * @path /lists/{listId}
     * @allow (get, list) - Any authenticated user can read lists.
     * @deny (create, update, delete) - Only the owner can modify lists.
     */
    match /lists/{listId} {
      allow get, list: if true;
        allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
        allow update: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
        allow delete: if isSignedIn() && resource != null; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}