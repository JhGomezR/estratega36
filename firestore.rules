/**
 * @file Firestore Security Rules
 * @description This ruleset allows any user to read, create, edit, and delete any document in the cities collection.
 *
 * Core Philosophy:
 * This ruleset prioritizes open access for prototyping and development.  All data is world-readable and writable.
 * This should NEVER be used in a production environment as it provides no real security.
 *
 * Data Structure:
 *  - /cities/{cityId}: Stores city information.
 *
 * Key Security Decisions:
 *  - The rules are configured to allow any user to read, create, update and delete any documents.
 *  - In a production environment, this should NEVER be the case, since anyone could modify and delete any document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any user to read, create, update and delete any city.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read any city.
     * @allow (create, update, delete) Any user can create, update or delete any city.
     * @deny None. This rule is completely open.
     * @principle Allows open access to city data for prototyping.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update and delete any campaign.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read any campaign.
     * @allow (create, update, delete) Any user can create, update or delete any campaign.
     * @deny None. This rule is completely open.
     * @principle Allows open access to campaign data for prototyping.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update and delete any voter.
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read any voter.
     * @allow (create, update, delete) Any user can create, update or delete any voter.
     * @deny None. This rule is completely open.
     * @principle Allows open access to voter data for prototyping.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update and delete any user.
     * @path /users/{userId}
     * @allow (get, list) Any user can read any user.
     * @allow (create, update, delete) Any user can create, update or delete any user.
     * @deny None. This rule is completely open.
     * @principle Allows open access to user data for prototyping.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update and delete any role.
     * @path /roles/{roleId}
     * @allow (get, list) Any user can read any role.
     * @allow (create, update, delete) Any user can create, update or delete any role.
     * @deny None. This rule is completely open.
     * @principle Allows open access to role data for prototyping.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}