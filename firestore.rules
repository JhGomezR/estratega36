
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================

    /**
     * Checks if the user is authenticated.
     * @returns {boolean} True if the user is signed in.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Gets the user's own data document from the /users collection.
     * @param userId The UID of the user.
     * @returns {Resource} The user's document data.
     */
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    /**
     * Gets the role document associated with a user.
     * @param userId The UID of the user.
     * @returns {Resource} The role document data.
     */
    function getUserRole(userId) {
      let userData = getUserData(userId);
      let roleId = userData.roleId;
      return get(/databases/$(database)/documents/roles/$(roleId)).data;
    }

    /**
     * Checks if the currently authenticated user's role has a specific permission.
     * Grants full access to super admins.
     * @param permission The permission string to check (e.g., 'campaign:read').
     * @returns {boolean} True if the user has the permission.
     */
    function hasPermission(permission) {
      let userRole = getUserRole(request.auth.uid);
      return isAuthenticated() && (
        request.auth.token.email == 'axdrcys@gmail.com' ||
        userRole.name.lower() == 'super' ||
        userRole.name.lower() == 'admin' ||
        permission in userRole.permissions
      );
    }

    // =====================================================================
    // Collection Rules
    // =====================================================================

    /**
     * @description Rules for the 'users' collection.
     * - Admins can manage all users.
     * - Users can read and update their own profile.
     */
    match /users/{userId} {
      allow read: if hasPermission('user:read') || (isAuthenticated() && request.auth.uid == userId);
      allow create: if hasPermission('user:create');
      allow update: if hasPermission('user:update') || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if hasPermission('user:delete');
    }

    /**
     * @description Rules for the 'roles' collection.
     * Only users with 'role' permissions can manage roles.
     */
    match /roles/{roleId} {
      allow read: if hasPermission('role:read');
      allow create: if hasPermission('role:create');
      allow update: if hasPermission('role:update');
      allow delete: if hasPermission('role:delete');
    }

    /**
     * @description Rules for the 'campaigns' collection.
     */
    match /campaigns/{campaignId} {
      allow read: if hasPermission('campaign:read');
      allow create: if hasPermission('campaign:create');
      allow update: if hasPermission('campaign:update');
      allow delete: if hasPermission('campaign:delete');
    }
    
    /**
     * @description Rules for the 'strategies' collection.
     * Linked to campaign permissions.
     */
    match /strategies/{strategyId} {
      allow read, create, update, delete: if hasPermission('campaign:read'); // Reuse campaign read perm
    }

    /**
     * @description Rules for the 'voters' collection.
     */
    match /voters/{voterId} {
      allow read: if hasPermission('voter:read');
      allow create: if hasPermission('voter:create');
      allow update: if hasPermission('voter:update');
      allow delete: if hasPermission('voter:delete');
    }
    
    /**
     * @description Rules for geographical data.
     */
    match /countries/{countryId} {
        allow read: if hasPermission('city:read');
        allow write: if hasPermission('city:create') || hasPermission('city:update') || hasPermission('city:delete');
        
        match /departments/{departmentId} {
            allow read: if hasPermission('city:read');
            allow write: if hasPermission('city:create') || hasPermission('city:update') || hasPermission('city:delete');

            match /cities/{cityId} {
                allow read: if hasPermission('city:read');
                allow write: if hasPermission('city:create') || hasPermission('city:update') || hasPermission('city:delete');
            }
        }
    }
    
    /**
     * @description Allows collection group queries needed for forms.
     */
    match /{path=**}/departments/{departmentId} {
      allow get, list: if hasPermission('city:read');
    }
    match /{path=**}/cities/{cityId} {
      allow get, list: if hasPermission('city:read');
    }


    /**
     * @description Rules for the 'tasks' collection.
     */
    match /tasks/{taskId} {
      allow read: if hasPermission('task:read');
      allow create: if hasPermission('task:create');
      allow update: if hasPermission('task:update');
      allow delete: if hasPermission('task:delete');
    }

    /**
     * @description Rules for the 'calls' collection.
     */
    match /calls/{callId} {
      allow read: if hasPermission('call:read');
      allow create: if hasPermission('call:create');
      allow update: if hasPermission('call:update');
      allow delete: if hasPermission('call:delete');
    }

    /**
     * @description Rules for application settings.
     * Allows public read for branding, but write is restricted.
     */
    match /settings/{document=**} {
      allow get: if true;
      allow list, write: if hasPermission('setting:update');
    }
    
     /**
     * @description Rules for managed lists.
     * Reuses 'setting:update' as this is an administrative task.
     */
    match /lists/{listId} {
      allow read: if isAuthenticated(); // All authenticated users can read lists
      allow write: if hasPermission('setting:update');
    }

    /**
     * @description Rules for social listening.
     * Reuses 'report:read' as it's a data analysis feature.
     */
    match /keywords/{keywordId} {
        allow read, write: if hasPermission('report:read');
    }
    match /socialMentions/{mentionId} {
        allow read, write: if hasPermission('report:read');
    }
  }
}
