/**
 * @file Firestore Security Rules
 * @description This ruleset allows any user to read, create, edit, and delete data in the database.
 *
 * Core Philosophy:
 * The rules are configured to allow open access for all operations. This is useful for prototyping.
 *
 * Data Structure:
 * The database contains collections for users, roles, campaigns, voters, and cities.
 *
 * Key Security Decisions:
 * No specific authorization checks are implemented, granting open access to all data.
 *
 * WARNING: These rules provide NO AUTHORIZATION and should NEVER be used in a production application.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any user to read, create, update, and delete user profiles.
     * @path /users/{userId}
     * @allow (get, list) Any user can read user profiles.
     * @allow (create, update, delete) Any user can create, update, or delete user profiles.
     * @deny (none)
     * @principle Open access is configured for prototyping purposes.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete roles.
     * @path /roles/{roleId}
     * @allow (get, list) Any user can read roles.
     * @allow (create, update, delete) Any user can create, update, or delete roles.
     * @deny (none)
     * @principle Open access is configured for prototyping purposes.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete campaigns.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read campaigns.
     * @allow (create, update, delete) Any user can create, update, or delete campaigns.
     * @deny (none)
     * @principle Open access is configured for prototyping purposes.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete voters.
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read voter information.
     * @allow (create, update, delete) Any user can create, update, or delete voter information.
     * @deny (none)
     * @principle Open access is configured for prototyping purposes.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read, create, update, and delete cities.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read city information.
     * @allow (create, update, delete) Any user can create, update, or delete city information.
     * @deny (none)
     * @principle Open access is configured for prototyping purposes.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}