/**
 * @file Firestore Security Rules
 * @description This ruleset allows anyone to create, update, and delete data in all collections.
 *   This is intended for prototyping and should be replaced with more restrictive rules for production.
 * @dataStructure
 *   /users/{userId} - Stores user profiles.
 *   /roles/{roleId} - Stores role definitions.
 *   /campaigns/{campaignId} - Stores campaign information.
 *   /voters/{voterId} - Stores voter information.
 *   /cities/{cityId} - Stores city information.
 * @keySecurityDecisions
 *   - All collections are writeable by anyone. This is unsafe for production.
 *   - Read access is public for all collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read and write user profiles.
     * @path /users/{userId}
     * @allow (create) - Any authenticated user can create a user profile.
     * @allow (update) - Any authenticated user can update any user profile.
     * @allow (delete) - Any authenticated user can delete any user profile.
     * @deny (none) - No restrictions on read/write access.
     * @principle Open access for prototyping.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write role definitions.
     * @path /roles/{roleId}
     * @allow (create) - Any authenticated user can create a role.
     * @allow (update) - Any authenticated user can update any role.
     * @allow (delete) - Any authenticated user can delete any role.
     * @deny (none) - No restrictions on read/write access.
     * @principle Open access for prototyping.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write campaign information.
     * @path /campaigns/{campaignId}
     * @allow (create) - Any authenticated user can create a campaign.
     * @allow (update) - Any authenticated user can update any campaign.
     * @allow (delete) - Any authenticated user can delete any campaign.
     * @deny (none) - No restrictions on read/write access.
     * @principle Open access for prototyping.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write voter information.
     * @path /voters/{voterId}
     * @allow (create) - Any authenticated user can create a voter.
     * @allow (update) - Any authenticated user can update any voter.
     * @allow (delete) - Any authenticated user can delete any voter.
     * @deny (none) - No restrictions on read/write access.
     * @principle Open access for prototyping.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read and write city information.
     * @path /cities/{cityId}
     * @allow (create) - Any authenticated user can create a city.
     * @allow (update) - Any authenticated user can update any city.
     * @allow (delete) - Any authenticated user can delete any city.
     * @deny (none) - No restrictions on read/write access.
     * @principle Open access for prototyping.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}