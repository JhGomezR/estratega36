/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure, owner-centric access control model. Users should only be able to
 * read, create, update, or delete data that they explicitly own or have been granted specific access to.
 *
 * Data Structure:
 * - `/users/{userId}`: Each user has their own document containing profile information. Access is restricted to the owning user.
 * - `/roles/{roleId}`: Defines user roles and their permissions. Publicly readable, but only admins can modify.
 * - `/campaigns/{campaignId}`: Stores campaign data. Write access is restricted to authorized users (e.g., campaign managers).
 * - `/campaigns/{campaignId}/generatedStrategies/{strategyId}`: Stores AI-generated campaign strategies. Write access follows that of campaigns.
 * - `/voters/{voterId}`: Stores voter data. Access is limited to authorized campaign users.
 * - `/cities/{cityId}`: Stores city data. Publicly readable, but only admins can modify.
 * - `/tasks/{taskId}`: Stores tasks associated with campaigns. Access is limited to assigned users and campaign managers.
 * - `/calls/{callId}`: Stores call records. Access is restricted to the user who made the call and authorized campaign users.
 * - `/settings/branding`: Stores application-wide branding settings. Publicly readable, but only admins can modify. Only one document exists.
 * - `/lists/{listId}`: Stores user-managed lists. Access is limited to the owning user.
 *
 * Key Security Decisions:
 * - No user listing: The rules explicitly prevent listing all users for privacy.
 * - Role-based access: Permissions are managed through roles.
 * - Strict ownership: Most data is owned by a specific user and only they can modify it.
 * - Publicly readable settings: Branding settings and city data are publicly readable to allow for a better user experience.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's ID matches the resource's userId and the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data.id == request.auth.uid;
    }

    /**
     * @description Allows anyone to read the data. Use with caution.
     */
    function isPublicRead() {
      return true;
    }

    /**
     * @description Denies all access.
     */
    function denyAll() {
      return false;
    }

    /**
     * @description Enforces that a specified field is immutable during updates.
     * @param {string} field The name of the field to check for immutability.
     */
    function isImmutable(field) {
      return resource.data[field] == request.resource.data[field];
    }

    /**
     * @description Stores user profiles.
     * @path /users/{userId}
     * @allow (create) - User with matching ID can create their own profile.
     * @allow (get, update, delete) - User can access and modify their own profile.
     * @deny (create) - User cannot create a profile with an ID that doesn't match their own.
     * @deny (list) - Listing all users is not permitted.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Stores role definitions, with specific roles for 'admin', 'campaign_manager', and 'promoter'.
     * @path /roles/{roleId}
     * @allow (get, list) - Everyone can read role definitions.
     * @deny (create, update, delete) - Only admins can create, update, or delete roles.  No admin role exits, so this is disabled for now
     * @principle Publicly readable data, but restricted writes.
     */
    match /roles/{roleId} {
      allow get, list: if isPublicRead();
      allow create, update, delete: if false; // TODO: Implement Admin-only access.
    }

    /**
     * @description Stores campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Anyone can read campaign information.
     * @deny (create, update, delete) - Only authorized users (e.g., campaign managers) can modify campaign information.
     * @principle Publicly readable data, but restricted writes.
     */
    match /campaigns/{campaignId} {
      allow get, list: if isPublicRead();
      allow create, update, delete: if false; // TODO: Implement campaign manager-only access.
    }

    /**
     * @description Stores AI-generated strategies for a specific campaign.
     * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
     * @allow (get, list) - Anyone can read generated strategies for a campaign.
     * @deny (create, update, delete) - Only authorized users can modify generated strategies.
     * @principle Publicly readable data, but restricted writes, inherited from parent campaign.
     */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
      allow get, list: if isPublicRead();
      allow create, update, delete: if false; // TODO: Implement campaign manager-only access, inherited from parent campaign.
    }

    /**
     * @description Stores voter information.
     * @path /voters/{voterId}
     * @deny (get, list, create, update, delete) - Access to voter information is restricted.
     * @principle Requires authorization, no public access.
     */
    match /voters/{voterId} {
      allow get, list, create, update, delete: if false; // TODO: Implement access based on campaign and role.
    }

    /**
     * @description Stores city information.
     * @path /cities/{cityId}
     * @allow (get, list) - Anyone can read city information.
     * @deny (create, update, delete) - Only admins can create, update, or delete city information.
     * @principle Publicly readable data, but restricted writes.
     */
    match /cities/{cityId} {
      allow get, list: if isPublicRead();
      allow create, update, delete: if false; // TODO: Implement Admin-only access.
    }

    /**
     * @description Stores campaign tasks.
     * @path /tasks/{taskId}
     * @deny (get, list, create, update, delete) - Access to tasks is restricted.
     * @principle Requires authorization, no public access.
     */
    match /tasks/{taskId} {
      allow get, list, create, update, delete: if false; // TODO: Implement access based on campaign, role, and assignment.
    }

    /**
     * @description Stores call records for voters.
     * @path /calls/{callId}
     * @deny (get, list, create, update, delete) - Access to call records is restricted.
     * @principle Requires authorization, no public access.
     */
    match /calls/{callId} {
      allow get, list, create, update, delete: if false; // TODO: Implement access based on user and campaign.
    }

    /**
     * @description Stores the single document for application branding settings.
     * @path /settings/branding
     * @allow (get) - Anyone can read branding settings.
     * @deny (list, create, update, delete) - Only admins can modify branding settings.
     * @principle Publicly readable data, but restricted writes.
     */
    match /settings/branding {
      allow get: if isPublicRead();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false; // TODO: Implement Admin-only access.
    }

    /**
     * @description Stores documents for user-managed lists. The document ID is the list name (e.g., 'taskPriorities').
     * @path /lists/{listId}
     * @allow (get, list, create, update, delete) - User can manage their own lists.
     * @principle Enforces document ownership for writes.
     */
    match /lists/{listId} {
      allow get: if isSignedIn(); // TODO: Add specific list membership.
      allow list: if isSignedIn(); // TODO: Review listability requirements
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid; // TODO: Add owner validation
      allow update: if isSignedIn() && request.resource.data.owner == request.auth.uid; // TODO: Add owner validation
      allow delete: if isSignedIn() && resource.data.owner == request.auth.uid; // TODO: Add owner validation
    }
  }
}