/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and allows public read access to roles, campaigns, voters, and cities.
 * Write access to these collections is restricted.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, secured by owner-only access.
 * - /roles/{roleId}: Stores role definitions, publicly readable, restricted writes.
 * - /campaigns/{campaignId}: Stores campaign information, publicly readable, restricted writes.
 * - /voters/{voterId}: Stores voter information, publicly readable, restricted writes.
 * - /cities/{cityId}: Stores city information, publicly readable, restricted writes.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data under /users/{userId}.
 * - Public read access is granted to /roles, /campaigns, /voters, and /cities.
 * - Write access is restricted to prevent unauthorized modifications.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their own profile document at /users/user123.
     * @allow (get, update, delete) - User with ID 'user123' can read, update, and delete their own profile document at /users/user123.
     * @deny (create) - User with ID 'user456' cannot create a profile document at /users/user123.
     * @deny (get, update, delete) - User with ID 'user456' cannot read, update, or delete the profile document at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to role definition documents.
     * @path /roles/{roleId}
     * @allow (get, list) - Any user can read role definitions.
     * @deny (create, update, delete) - No user can create, update, or delete role definitions.
     * @principle Allows public read access but restricts writes.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to campaign information documents.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Any user can read campaign information.
     * @deny (create, update, delete) - No user can create, update, or delete campaign information.
     * @principle Allows public read access but restricts writes.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to voter information documents.
     * @path /voters/{voterId}
     * @allow (get, list) - Any user can read voter information.
     * @deny (create, update, delete) - No user can create, update, or delete voter information.
     * @principle Allows public read access but restricts writes.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to city information documents.
     * @path /cities/{cityId}
     * @allow (get, list) - Any user can read city information.
     * @deny (create, update, delete) - No user can create, update, or delete city information.
     * @principle Allows public read access but restricts writes.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the request is made by the owner of the document.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the request is made by the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of the document and the document exists.
     * @param {string} userId The user ID to compare against the request's auth UID.
     * @return {bool} True if the request is made by the owner and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}