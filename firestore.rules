/**
 * @file Firestore Security Rules
 * @description This ruleset allows any authenticated user to perform all CRUD operations on all collections.
 *
 * Core Philosophy:
 * The ruleset prioritizes developer convenience for rapid prototyping.  All authenticated users are granted full read and write access to all collections.
 *
 * Data Structure:
 * The Firestore database contains top-level collections for 'users', 'roles', 'campaigns', 'voters', and 'cities'.
 *
 * Key Security Decisions:
 * - Unrestricted Access: Any logged-in user can create, read, update, and delete any document.
 * - No Data Validation: Data validation is skipped to facilitate rapid prototyping.  Data schema and type enforcement are not part of this ruleset.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Grants full CRUD access to any authenticated user for user profiles.
     * @path /users/{userId}
     * @allow (create) User with auth data can create a profile
     * @allow (get) Any authenticated user can read any profile
     * @allow (update) Any authenticated user can update any profile
     * @allow (delete) Any authenticated user can delete any profile
     * @deny (create) Unauthenticated user cannot create a profile
     * @deny (get) N/A
     * @deny (update) N/A
     * @deny (delete) N/A
     * @principle Allows any authenticated user to perform any operation on any user document
     */
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full CRUD access to any authenticated user for roles.
     * @path /roles/{roleId}
     * @allow (create) User with auth data can create a role
     * @allow (get) Any authenticated user can read any role
     * @allow (update) Any authenticated user can update any role
     * @allow (delete) Any authenticated user can delete any role
     * @deny (create) Unauthenticated user cannot create a role
     * @deny (get) N/A
     * @deny (update) N/A
     * @deny (delete) N/A
     * @principle Allows any authenticated user to perform any operation on any role document
     */
    match /roles/{roleId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full CRUD access to any authenticated user for campaigns.
     * @path /campaigns/{campaignId}
     * @allow (create) User with auth data can create a campaign
     * @allow (get) Any authenticated user can read any campaign
     * @allow (update) Any authenticated user can update any campaign
     * @allow (delete) Any authenticated user can delete any campaign
     * @deny (create) Unauthenticated user cannot create a campaign
     * @deny (get) N/A
     * @deny (update) N/A
     * @deny (delete) N/A
     * @principle Allows any authenticated user to perform any operation on any campaign document
     */
    match /campaigns/{campaignId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full CRUD access to any authenticated user for voters.
     * @path /voters/{voterId}
     * @allow (create) User with auth data can create a voter
     * @allow (get) Any authenticated user can read any voter
     * @allow (update) Any authenticated user can update any voter
     * @allow (delete) Any authenticated user can delete any voter
     * @deny (create) Unauthenticated user cannot create a voter
     * @deny (get) N/A
     * @deny (update) N/A
     * @deny (delete) N/A
     * @principle Allows any authenticated user to perform any operation on any voter document
     */
    match /voters/{voterId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full CRUD access to any authenticated user for cities.
     * @path /cities/{cityId}
     * @allow (create) User with auth data can create a city
     * @allow (get) Any authenticated user can read any city
     * @allow (update) Any authenticated user can update any city
     * @allow (delete) Any authenticated user can delete any city
     * @deny (create) Unauthenticated user cannot create a city
     * @deny (get) N/A
     * @deny (update) N/A
     * @deny (delete) N/A
     * @principle Allows any authenticated user to perform any operation on any city document
     */
    match /cities/{cityId} {
      allow read, write: if isSignedIn();
    }
  }
}