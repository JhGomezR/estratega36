/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model, granting 'admin' and 'super_admin' roles full access to all data.
 * @dataStructure
 * - /users/{userId}: Stores user profiles.
 * - /roles/{roleId}: Stores role definitions.
 * - /campaigns/{campaignId}: Stores campaign information.
 * - /campaigns/{campaignId}/generatedStrategies/{strategyId}: Stores AI-generated strategies for a specific campaign.
 * - /voters/{voterId}: Stores voter information.
 * - /cities/{cityId}: Stores city information.
 * - /tasks/{taskId}: Stores campaign tasks.
 * - /calls/{callId}: Stores call records for voters.
 * - /settings/branding: Stores application branding settings.
 * - /lists/{listId}: Stores user-managed lists.
 * @keySecurityDecisions
 * - Admins and super admins have full CRUD access to all collections.
 * - Other roles or unauthenticated users are not explicitly granted any access in this prototype.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants full access to admins and super admins for user profiles.
     * @path /users/{userId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any user profile.
     * @deny (read, write, create, update, delete) - A non-admin user cannot access any user profile other than their own.
     * @principle Role-based access control.
     */
    match /users/{userId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for role definitions.
     * @path /roles/{roleId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any role definition.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify roles.
     * @principle Role-based access control.
     */
    match /roles/{roleId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for campaign information.
     * @path /campaigns/{campaignId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any campaign.
     * @deny (read, write, create, update, delete) - A non-admin user cannot create, modify, or delete campaigns.
     * @principle Role-based access control.
     */
    match /campaigns/{campaignId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();

       /**
        * @description Grants full access to admins and super admins for AI-generated strategies for a specific campaign.
        * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
        * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any generated strategy.
        * @deny (read, write, create, update, delete) - A non-admin user cannot modify or delete generated strategies.
        * @principle Role-based access control.
        */
      match /generatedStrategies/{strategyId} {
        allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
      }
    }

    /**
     * @description Grants full access to admins and super admins for voter information.
     * @path /voters/{voterId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any voter.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify or delete voter information.
     * @principle Role-based access control.
     */
    match /voters/{voterId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for city information.
     * @path /cities/{cityId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any city.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify or delete city information.
     * @principle Role-based access control.
     */
    match /cities/{cityId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for campaign tasks.
     * @path /tasks/{taskId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any task.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify or delete tasks.
     * @principle Role-based access control.
     */
    match /tasks/{taskId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for call records for voters.
     * @path /calls/{callId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any call record.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify or delete call records.
     * @principle Role-based access control.
     */
    match /calls/{callId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for application branding settings.
     * @path /settings/branding
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on the branding settings.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify branding settings.
     * @principle Role-based access control.
     */
    match /settings/branding {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Grants full access to admins and super admins for user-managed lists.
     * @path /lists/{listId}
     * @allow (read, write, create, update, delete) - An admin or super admin can perform any operation on any list.
     * @deny (read, write, create, update, delete) - A non-admin user cannot modify or delete lists.
     * @principle Role-based access control.
     */
    match /lists/{listId} {
      allow get, list, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    /**
     * @description Helper function to check if the user has the 'admin' role.
     * @return {boolean} True if the user has the 'admin' role, false otherwise.
     */
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/roles/admin).data.permissions.hasAny(['campaign:create', 'campaign:read', 'campaign:update', 'campaign:delete',
              'voter:create', 'voter:read', 'voter:update', 'voter:delete',
              'user:create', 'user:read', 'user:update', 'user:delete',
              'role:create', 'role:read', 'role:update', 'role:delete',
              'city:create', 'city:read', 'city:update', 'city:delete',
              'task:create', 'task:read', 'task:update', 'task:delete',
              'call:create', 'call:read', 'call:update', 'call:delete',
              'report:read',
              'setting:update']);
    }

    /**
     * @description Helper function to check if the user has the 'super_admin' role.
     * @return {boolean} True if the user has the 'super_admin' role, false otherwise.
     */
    function isSuperAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/roles/super_admin).data.permissions.hasAny(['campaign:create', 'campaign:read', 'campaign:update', 'campaign:delete',
              'voter:create', 'voter:read', 'voter:update', 'voter:delete',
              'user:create', 'user:read', 'user:update', 'user:delete',
              'role:create', 'role:read', 'role:update', 'role:delete',
              'city:create', 'city:read', 'city:update', 'city:delete',
              'task:create', 'task:read', 'task:update', 'task:delete',
              'call:create', 'call:read', 'call:update', 'call:delete',
              'report:read',
              'setting:update']);
    }
  }
}