rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the document.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the document, and that the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource);
    }

    /**
     * @description Enforces that the user ID in the path matches the user ID in the data.
     */
    function isValidOwnerId(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * @description Stores user profiles, accessible only by the owning user.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @deny (create) User with ID 'user123' cannot create a profile with a different ID 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Disallow listing users for privacy.
      allow list: if false;

      // Allow a user to create their own profile.
      allow create: if isOwner(userId) && request.auth.uid == userId;

      // Allow a user to get their own profile.
      allow get: if isOwner(userId);

      // Allow a user to update their own profile.
      allow update: if isOwner(userId);

      // Allow a user to delete their own profile.
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores role definitions, publicly readable but not writable.
     * @path /roles/{roleId}
     * @allow (get) Any user can read role definitions.
     * @deny (create) No user can create role definitions.
     * @principle Restricts write access to roles collection.
     */
    match /roles/{roleId} {
      // Allow anyone to read role definitions.
      allow get, list: if true;

      // Disallow creating, updating, and deleting roles.
      allow create, update, delete: if false;
    }

    /**
     * @description Stores campaign information, publicly readable but only writable by authenticated users.
     * @path /campaigns/{campaignId}
     * @allow (get) Any user can read campaign information.
     * @allow (create) Authenticated users can create campaigns if request.auth.uid == request.resource.data.ownerId
     * @deny (create) Unauthenticated users cannot create campaigns.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /campaigns/{campaignId} {
      // Allow anyone to read campaign information.
      allow get, list: if true;

      // Allow create, update, delete only if the user is authenticated and the ownerId matches.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Stores voter information, publicly readable but only writable by authenticated users.
     * @path /voters/{voterId}
     * @allow (get) Any user can read voter information.
     * @allow (create) Authenticated users can create voters if request.auth.uid == request.resource.data.ownerId
     * @deny (create) Unauthenticated users cannot create voters.
     * @principle Enforces document ownership for writes, allows public reads.
     */
    match /voters/{voterId} {
      // Allow anyone to read voter information.
      allow get, list: if true;

      // Allow create, update, delete only if the user is authenticated and the ownerId matches.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Stores city information, publicly readable but not writable.
     * @path /cities/{cityId}
     * @allow (get) Any user can read city information.
     * @deny (create) No user can create city information.
     * @principle Restricts write access to cities collection.
     */
    match /cities/{cityId} {
      // Allow anyone to read city information.
      allow get, list: if true;

      // Disallow creating, updating, and deleting cities.
      allow create, update, delete: if false;
    }
  }
}