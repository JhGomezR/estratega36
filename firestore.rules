/**
 * @fileOverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and open read access to other collections.
 * Only authenticated users can create, update, or delete their own profiles.
 * All users can read data from roles, campaigns, voters, and cities.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the user themselves.
 * - /roles/{roleId}: Stores role definitions, publicly readable.
 * - /campaigns/{campaignId}: Stores campaign information, publicly readable.
 * - /voters/{voterId}: Stores voter information, publicly readable.
 * - /cities/{cityId}: Stores city information, publicly readable.
 *
 * Key Security Decisions:
 * - User profiles are strictly controlled by the individual user (ownership model).
 * - Other collections (roles, campaigns, voters, cities) are publicly readable to facilitate data access for all users.
 * - No listing of user documents is allowed to prevent information disclosure.
 *
 * Denormalization for Authorization: N/A (no cross-collection authorization is required in this version).
 * Structural Segregation: N/A (no public vs. private data segregation is required in this version).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Only the authenticated user can read and write their own profile.
     * @path /users/{userId}
     * @allow (create) - An authenticated user with UID 'user_abc' can create a profile at /users/user_abc. The 'id' field must match the UID.
     * @deny (create) - An unauthenticated user attempts to create a profile.
     * @deny (create) - An authenticated user with UID 'user_abc' attempts to create a profile at /users/user_xyz.
     * @allow (get) - An authenticated user with UID 'user_abc' can read their own profile at /users/user_abc.
     * @deny (get) - An authenticated user with UID 'user_abc' attempts to read another user's profile at /users/user_xyz.
     * @allow (update) - An authenticated user with UID 'user_abc' can update their own profile at /users/user_abc.
     * @deny (update) - An authenticated user with UID 'user_abc' attempts to update another user's profile at /users/user_xyz.
     * @allow (delete) - An authenticated user with UID 'user_abc' can delete their own profile at /users/user_abc.
     * @deny (delete) - An authenticated user with UID 'user_abc' attempts to delete another user's profile at /users/user_xyz.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing user documents is disallowed.
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages role definitions. All users can read role data.
     * @path /roles/{roleId}
     * @allow (get) - Any user (authenticated or not) can read a role document.
     * @allow (list) - Any user (authenticated or not) can list role documents.
     * @deny (create) - No one can create role documents through the client.
     * @deny (update) - No one can update role documents through the client.
     * @deny (delete) - No one can delete role documents through the client.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages campaign information. All users can read campaign data.
     * @path /campaigns/{campaignId}
     * @allow (get) - Any user (authenticated or not) can read a campaign document.
     * @allow (list) - Any user (authenticated or not) can list campaign documents.
     * @deny (create) - No one can create campaign documents through the client.
     * @deny (update) - No one can update campaign documents through the client.
     * @deny (delete) - No one can delete campaign documents through the client.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages voter information. All users can read voter data.
     * @path /voters/{voterId}
     * @allow (get) - Any user (authenticated or not) can read a voter document.
     * @allow (list) - Any user (authenticated or not) can list voter documents.
     * @deny (create) - No one can create voter documents through the client.
     * @deny (update) - No one can update voter documents through the client.
     * @deny (delete) - No one can delete voter documents through the client.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Manages city information. All users can read city data.
     * @path /cities/{cityId}
     * @allow (get) - Any user (authenticated or not) can read a city document.
     * @allow (list) - Any user (authenticated or not) can list city documents.
     * @deny (create) - No one can create city documents through the client.
     * @deny (update) - No one can update city documents through the client.
     * @deny (delete) - No one can delete city documents through the client.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Placeholder for tasks collection.  Read operations are currently denied.
     * @path /tasks
     * @deny (get) - Any user (authenticated or not) is denied to read a tasks document.
     * @deny (list) - Any user (authenticated or not) is denied to list tasks documents.
     * @deny (create) - No one can create tasks documents through the client.
     * @deny (update) - No one can update tasks documents through the client.
     * @deny (delete) - No one can delete tasks documents through the client.
     */
    match /tasks {
      allow get, list: if false;
      allow create, update, delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}