/**
 * @file Firebase Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access for roles, campaigns, voters and cities.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the authenticated user can read or write their own profile.
 * - /roles/{roleId}: Stores role definitions. These are publicly readable.
 * - /campaigns/{campaignId}: Stores campaign information. These are publicly readable.
 * - /voters/{voterId}: Stores voter information. These are publicly readable.
 * - /cities/{cityId}: Stores city information. These are publicly readable.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied for security reasons.
 * - Public read access is granted to the roles, campaigns, voters and cities collections to allow unauthenticated clients to retrieve necessary data.
 * - All write operations require authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {boolean} True if the request is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is signed in and their ID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is signed in, their ID matches, and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines security rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User 'user_abc' with auth.uid 'user_abc' can create their profile.
     * @deny (create) User 'user_xyz' with auth.uid 'user_abc' cannot create a profile for 'user_abc'.
     * @allow (get, update, delete) User 'user_abc' with auth.uid 'user_abc' can read, update, and delete their profile.
     * @deny (get, update, delete) User 'user_xyz' with auth.uid 'user_xyz' cannot read, update, or delete 'user_abc' profile.
     * @principle Enforces document ownership for reads and writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines security rules for the /roles/{roleId} collection.
     * @path /roles/{roleId}
     * @allow (get, list) Any user (signed in or not) can read role definitions.
     * @deny (create, update, delete) No one can create, update, or delete roles via the client.
     * @principle Allows public read access.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines security rules for the /campaigns/{campaignId} collection.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user (signed in or not) can read campaign information.
     * @deny (create, update, delete) No one can create, update, or delete campaigns via the client.
     * @principle Allows public read access.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines security rules for the /voters/{voterId} collection.
     * @path /voters/{voterId}
     * @allow (get, list) Any user (signed in or not) can read voter information.
     * @deny (create, update, delete) No one can create, update, or delete voters via the client.
     * @principle Allows public read access.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines security rules for the /cities/{cityId} collection.
     * @path /cities/{cityId}
     * @allow (get, list) Any user (signed in or not) can read city information.
     * @deny (create, update, delete) No one can create, update, or delete cities via the client.
     * @principle Allows public read access.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}