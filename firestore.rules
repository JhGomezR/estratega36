/**
 * @file Firestore Security Rules
 * @description This ruleset allows any authenticated user to read, create, update, and delete data in all collections.
 *
 * Data Structure:
 * - Top-level collections: /users, /roles, /campaigns, /voters, /cities, /tasks.
 *
 * Key Security Decisions:
 * - All collections are publicly accessible for read and write operations by authenticated users.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any authenticated user to read, create, update, and delete user profiles.
     * @path /users/{userId}
     * @allow (read, create, update, delete) - Any authenticated user can perform these actions.
     * @deny (none) - There are no specific restrictions.
     * @principle Allows all operations for prototyping.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete roles.
     * @path /roles/{roleId}
     * @allow (read, create, update, delete) - Any authenticated user can perform these actions.
     * @deny (none) - There are no specific restrictions.
     * @principle Allows all operations for prototyping.
     */
    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete campaigns.
     * @path /campaigns/{campaignId}
     * @allow (read, create, update, delete) - Any authenticated user can perform these actions.
     * @deny (none) - There are no specific restrictions.
     * @principle Allows all operations for prototyping.
     */
    match /campaigns/{campaignId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete voters.
     * @path /voters/{voterId}
     * @allow (read, create, update, delete) - Any authenticated user can perform these actions.
     * @deny (none) - There are no specific restrictions.
     * @principle Allows all operations for prototyping.
     */
    match /voters/{voterId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete cities.
     * @path /cities/{cityId}
     * @allow (read, create, update, delete) - Any authenticated user can perform these actions.
     * @deny (none) - There are no specific restrictions.
     * @principle Allows all operations for prototyping.
     */
    match /cities/{cityId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete tasks.
     * @path /tasks/{taskId}
     * @allow (read, create, update, delete) - Any authenticated user can perform these actions.
     * @deny (none) - There are no specific restrictions.
     * @principle Allows all operations for prototyping.
     */
    match /tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}