/**
 * @fileOverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and allows campaigns to be created without authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the user themselves.
 * - /roles/{roleId}: Stores role definitions (e.g., admin, campaign manager).
 * - /campaigns/{campaignId}: Stores campaign information, publicly readable, writable by anyone.
 * - /voters/{voterId}: Stores voter information.
 * - /cities/{cityId}: Stores city information.
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owning user.
 * - Campaign data is publicly accessible (read).
 * - There are no global admin roles defined.
 *
 * Denormalization for Authorization:
 *  - Not explicitly used in this version, but could be beneficial for future access control scenarios.
 *
 * Structural Segregation:
 *  - Uses separate collections for public (campaigns, cities) and private (users) data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, ensuring only the owning user can read or write their data.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create a profile with document ID 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can read/update/delete their own profile at /users/user123.
     * @deny (get, update, delete) - User with UID 'user456' cannot access profile data at /users/user123.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing of all users.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure role definitions. Read-only for all.
     * @path /roles/{roleId}
     * @allow (get, list) - Anyone can read role definitions.
     * @deny (create, update, delete) - No one can create, update, or delete roles via client-side rules.
     * @principle Allows public read access, restricts writes to the backend only.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure campaign information. Publicly readable, writable by anyone.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Anyone can read campaign information.
     * @allow (create) - Anyone can create a new campaign.
     * @deny (update, delete) - No one can update or delete existing campaigns via client-side rules.
     * @principle Allows public read access, restricts writes to the backend only.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure voter information.
     * @path /voters/{voterId}
     * @allow (get, list) - Anyone can read voter information.
     * @allow (create) - Anyone can create a new voter.
     * @deny (update, delete) - No one can update or delete existing voters via client-side rules.
     * @principle Allows public read access, restricts writes to the backend only.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secure city information. Read-only for all.
     * @path /cities/{cityId}
     * @allow (get, list) - Anyone can read city information.
     * @deny (create, update, delete) - No one can create, update, or delete cities via client-side rules.
     * @principle Allows public read access, restricts writes to the backend only.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}