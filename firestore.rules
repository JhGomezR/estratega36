/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and restricts listing of users. Campaigns, voters, cities, tasks, calls, and settings are publicly accessible for reading, but writing is restricted based on ownership or specific criteria.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /roles/{roleId}: Role definitions (e.g., admin, campaign_manager, promoter).
 * - /campaigns/{campaignId}: Campaign information.
 * - /campaigns/{campaignId}/generatedStrategies/{strategyId}: AI-generated campaign strategies.
 * - /voters/{voterId}: Voter information.
 * - /cities/{cityId}: City information.
 * - /tasks/{taskId}: Campaign tasks.
 * - /calls/{callId}: Call records for voters.
 * - /settings/branding: Application branding settings.
 * - /lists/{listId}: User-managed lists.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data. Listing of all users is disallowed to protect privacy.
 * - Campaigns, voters, cities, tasks, calls and lists are readable by everyone but creatable, updatable, and deletable by authorized users only.
 * - The branding settings document is readable by everyone, but only updateable by authorized users.
 * - No data shape validation is implemented in this initial prototyping phase.
 *
 * Denormalization for Authorization:
 *  - No specific denormalization needed.
 * Structural Segregation:
 *  - Data is not split into private and public collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID and if the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user IDs match and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
    }

    /**
     * @description Restricts access to user profiles to the owning user.
     * @path /users/{userId}
     * @allow (get, create, update, delete) User s031sQgjugYha5RcuBDeZzZnwnX2 can (get, create, update, delete) their own profile at /users/s031sQgjugYha5RcuBDeZzZnwnX2.
     * @deny (get, create, update, delete) User s031sQgjugYha5RcuBDeZzZnwnX2 cannot (get, create, update, delete) another user's profile at /users/anotherUserId.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows read access to all roles.
     * @path /roles/{roleId}
     * @allow (get, list) Any authenticated user can read role definitions.
     * @deny (create, update, delete) Only authorized users with specific roles can modify role definitions.
     * @principle Provides public read access with restricted write access.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization.
    }

    /**
     * @description Allows public read access to campaign data, but restricts creation, updates, and deletion to authorized users (e.g., campaign managers).
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read campaign data.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete campaigns.
     * @principle Provides public read access with restricted write access based on role or ownership.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for campaigns.
    }

    /**
     * @description Allows public read access to AI-generated strategies for campaigns, but restricts creation, updates, and deletion to authorized users.
     * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
     * @allow (get, list) Any user can read AI-generated campaign strategies.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete campaign strategies.
     * @principle Provides public read access with restricted write access based on role or ownership.
     */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for campaign strategies.
    }

    /**
     * @description Allows public read access to voter information, but restricts creation, updates, and deletion to authorized users (e.g., campaign managers, promoters).
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read voter data.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete voters.
     * @principle Provides public read access with restricted write access based on role or ownership.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for voters.
    }

    /**
     * @description Allows public read access to city information.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read city data.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete cities.
     * @principle Provides public read access with restricted write access.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for cities.
    }

    /**
     * @description Allows public read access to task information, but restricts creation, updates, and deletion to authorized users.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can read task data.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete tasks.
     * @principle Provides public read access with restricted write access based on role or ownership.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for tasks.
    }

    /**
     * @description Allows public read access to call information, but restricts creation, updates, and deletion to authorized users.
     * @path /calls/{callId}
     * @allow (get, list) Any user can read call data.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete calls.
     * @principle Provides public read access with restricted write access based on role or ownership.
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for calls.
    }

    /**
     * @description Allows public read access to branding settings, but restricts updates to authorized users.
     * @path /settings/branding
     * @allow (get) Any user can read branding settings.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete branding settings.
     * @principle Provides public read access with restricted write access.
     */
    match /settings/branding {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false; // TODO: Add role-based authorization for settings.
    }

    /**
     * @description Allows public read access to managed lists, but restricts creation, updates, and deletion to authorized users.
     * @path /lists/{listId}
     * @allow (get, list) Any user can read managed list data.
     * @deny (create, update, delete) Unauthorized users cannot create, update, or delete managed lists.
     */
    match /lists/{listId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add role-based authorization for lists.
    }
  }
}