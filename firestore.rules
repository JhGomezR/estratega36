/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-centric security model, ensuring that users can only
 * access and modify their own data, with the exception of public collections and specific
 * role-based access where applicable. Data shape is not strictly enforced for rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only by the user themselves.
 * - /roles/{roleId}: Stores role definitions, publicly readable.
 * - /campaigns/{campaignId}: Stores campaign information, publicly readable, with owner-only writes. Assumes a campaign has an 'ownerId' field.
 * - /voters/{voterId}: Stores voter information, publicly readable, with owner-only writes. Assumes a voter has an 'ownerId' field.
 * - /cities/{cityId}: Stores city information, publicly readable.
 *
 * Key Security Decisions:
 * - Users can only create, read, update, and delete their own user documents.
 * - Role and City data is publicly readable to facilitate application functionality.
 * - Campaign and voter data is publicly readable but only the owner can modify the data.
 * - Listing of users, roles, campaigns, voters, or cities is generally allowed to facilitate data discovery. This might be restricted in production.
 *
 * Denormalization for Authorization:
 *  - The 'Campaign' and 'Voter' entities are assumed to have an 'ownerId' field for owner-only writes.
 *  - If the 'ownerId' field is missing, the rules will be adjusted with a placeholder comment to alert the developer.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with auth UID 'user_abc' can create their profile at /users/user_abc.
     * @allow (get, update, delete) User with auth UID 'user_abc' can read, update, and delete their profile at /users/user_abc.
     * @deny (create, get, update, delete) User with auth UID 'user_xyz' cannot access user profile at /users/user_abc.
     * @principle Enforces document ownership for user profiles, ensuring users can only manage their own data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to role definition documents.
     * @path /roles/{roleId}
     * @allow (get, list) Any user can read role definitions.
     * @deny (create, update, delete) No user can create, update, or delete role definitions.
     * @principle Allows public read access to roles, while restricting write access to prevent unauthorized modifications.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to campaign information documents.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read campaign information.
     * @deny (create, update, delete) Only the campaign owner can create, update, or delete campaign information.
     * @principle Allows public read access to campaign data, while restricting write access to the owner.
     */
    match /campaigns/{campaignId} {
      function isOwner(ownerId) {
        return request.auth != null && request.auth.uid == ownerId;
      }
      function isExistingOwner(ownerId) {
          return isOwner(ownerId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to voter information documents.
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read voter information.
     * @deny (create, update, delete) Only the voter owner can create, update, or delete voter information.
     * @principle Allows public read access to voter data, while restricting write access to the owner.
     */
    match /voters/{voterId} {
      function isOwner(ownerId) {
        return request.auth != null && request.auth.uid == ownerId;
      }
      function isExistingOwner(ownerId) {
          return isOwner(ownerId) && resource != null;
      }

      allow get, list: if true;
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to city information documents.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read city information.
     * @deny (create, update, delete) No user can create, update, or delete city information.
     * @principle Allows public read access to cities, while restricting write access to prevent unauthorized modifications.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
     /**
      * @description Task collection, root error requested by NextJS.
      * @path /tasks
      * @allow (get, list) all tasks.
      * @deny (create, update, delete) No user can create, update, or delete tasks.
      * @principle Allows public read access to tasks, while restricting write access to prevent unauthorized modifications.
      */
    match /tasks {
        allow get, list: if true;
        allow create, update, delete: if false;
    }
  }
}