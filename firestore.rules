/**
 * @fileoverview Firestore Security Rules
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model. User-specific data is strictly controlled via ownership,
 * while campaign and role data can be publicly read but only modified by authorized users.
 *
 * Data Structure:
 * - /users/{userId}:  User profiles, accessible only to the user and potentially admins.
 * - /roles/{roleId}:  Role definitions. Publicly readable, but create/update/delete restricted.
 * - /campaigns/{campaignId}: Campaign data. Publicly readable, but create/update/delete restricted.
 * - /voters/{voterId}: Voter information, accessible only to authorized users (e.g., campaign managers, admins).
 * - /cities/{cityId}:  City data. Publicly readable.  Create/update/delete restricted.
 * - /tasks/{taskId}: Task data. Publicly readable, but create/update/delete restricted.
 *
 * Key Security Decisions:
 * - Listing of users is disallowed for privacy.
 * - Roles are readable by all, but only manageable via dedicated admin functions (not yet implemented in rules).
 * - Default deny: Any access not explicitly allowed is denied.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Stores user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get) User with UID 'user123' can read their profile.
     * @deny (create) User with UID 'user456' cannot create a profile for 'user123'.
     * @deny (update) User with UID 'user456' cannot update the profile for 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallowing listing for privacy.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Stores role definitions, with specific roles for 'admin', 'campaign_manager', and 'promoter'.
     * @path /roles/{roleId}
     * @allow (get) Any user can read role definitions.
     * @deny (create) No user can create role definitions through client-side rules.
     * @deny (update) No user can update role definitions through client-side rules.
     * @principle Roles are readable by all, but only manageable via dedicated admin functions (not yet implemented in rules).
     */
    match /roles/{roleId} {
      allow get: if true;
      allow list: if true; // Allowing listing of roles.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get) Any user can read campaign information.
     * @deny (create) No user can create campaigns through client-side rules.
     * @deny (update) No user can update campaigns through client-side rules.
     * @principle Campaigns are readable by all, but only manageable via dedicated admin functions (not yet implemented in rules).
     */
    match /campaigns/{campaignId} {
      allow get: if true;
      allow list: if true; // Allowing listing of campaigns.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores voter information.
     * @path /voters/{voterId}
     * @allow (get) Any user can read voter information.
     * @deny (create) No user can create voters through client-side rules.
     * @deny (update) No user can update voters through client-side rules.
     */
    match /voters/{voterId} {
      allow get: if false; // TODO:  Implement authorization based on campaign membership and roles
      allow list: if false; // TODO:  Implement authorization based on campaign membership and roles
      allow create: if false; // TODO:  Implement authorization based on campaign membership and roles
      allow update: if false; // TODO:  Implement authorization based on campaign membership and roles
      allow delete: if false; // TODO:  Implement authorization based on campaign membership and roles
    }

    /**
     * @description Stores city information.
     * @path /cities/{cityId}
     * @allow (get) Any user can read city information.
     * @deny (create) No user can create cities through client-side rules.
     * @deny (update) No user can update cities through client-side rules.
     */
    match /cities/{cityId} {
      allow get: if true;
      allow list: if true; // Allowing listing of cities.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores campaign tasks.
     * @path /tasks/{taskId}
     * @allow (get) Any user can read task information.
     * @deny (create) No user can create tasks through client-side rules.
     * @deny (update) No user can update tasks through client-side rules.
     */
    match /tasks/{taskId} {
      allow get: if true;
      allow list: if true; // Allowing listing of tasks.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}