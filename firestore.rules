/**
 * @file Firestore Security Rules
 * @description This ruleset is for **prototyping only** and provides a basic level of security.
 * It is crucial to replace these with more restrictive rules before deploying to production.
 *
 * Core Philosophy:
 * This ruleset focuses on allowing all access to all documents, as requested by the user.
 * It enforces minimal security checks and prioritizes rapid development over strict access control.
 *
 * Data Structure:
 * The Firestore database is structured with top-level collections for `users`, `roles`, `campaigns`, `voters`, `cities`, `tasks`, `calls`, `settings`, and `lists`.
 *
 * Key Security Decisions:
 * - All read and write operations are allowed for all users. This is **highly insecure** and should be changed immediately for production use.
 * - No data validation is performed. All writes are accepted as-is, regardless of the data's validity.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows all read and write access to user profiles.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any user profile.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to role definitions.
     * @path /roles/{roleId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any role definition.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any campaign.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to voter information.
     * @path /voters/{voterId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any voter.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to city information.
     * @path /cities/{cityId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any city.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to task information.
     * @path /tasks/{taskId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any task.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to call information.
     * @path /calls/{callId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any call.
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows all read and write access to branding settings.
     * @path /settings/branding
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify branding settings.
     */
    match /settings/branding {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
    
    /**
     * @description Allows all read and write access to managed lists.
     * @path /lists/{listId}
     * @allow (get, list, create, update, delete)
     * @principle Allows any user to read or modify any managed list.
     */
    match /lists/{listId} {
        allow get, list: if true;
        allow create, update, delete: if true;
    }
  }
}