rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles. Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create, update, delete): Authenticated user with matching userId.
     * @deny (create, update, delete): Mismatched userId or unauthenticated user.
     * @principle Enforces document ownership for writes and requires authentication for access.
     */
    match /users/{userId} {
      // Function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Function to check if the user is signed in and the document exists with the correct owner
      function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId);
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Listing users is not permitted

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Secures role definitions.  Read-only for all authenticated users. Write access is denied.
     * @path /roles/{roleId}
     * @allow (get, list): Authenticated users.
     * @deny (create, update, delete): All users.
     * @principle Provides read-only access to role data for authenticated users.
     */
    match /roles/{roleId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures campaign information.  Read-only for all authenticated users. Write access is denied.
     * @path /campaigns/{campaignId}
     * @allow (get, list): Authenticated users.
     * @deny (create, update, delete): All users.
     * @principle Provides read-only access to campaign data for authenticated users.
     */
    match /campaigns/{campaignId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures voter information.  Read-only for all authenticated users. Write access is denied.
     * @path /voters/{voterId}
     * @allow (get, list): Authenticated users.
     * @deny (create, update, delete): All users.
     * @principle Provides read-only access to voter data for authenticated users.
     */
    match /voters/{voterId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures city information.  Read-only for all authenticated users. Write access is denied.
     * @path /cities/{cityId}
     * @allow (get, list): Authenticated users.
     * @deny (create, update, delete): All users.
     * @principle Provides read-only access to city data for authenticated users.
     */
    match /cities/{cityId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}