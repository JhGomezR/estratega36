/**
 * @fileoverview Firestore Security Rules for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset provides open read and write access to all documents in the database.
 *
 * Data Structure:
 * The database is organized into top-level collections for users, roles, campaigns, voters, cities, tasks, calls, settings, and lists.
 * Some collections (e.g., `/campaigns/{campaignId}/generatedStrategies/{strategyId}`) nest data.
 *
 * Key Security Decisions:
 * - All `get` and `list` operations are allowed for everyone.
 * - All `create`, `update` and `delete` operations are allowed for everyone.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read and write access to user profiles.
     * @path /users/{userId}
     * @allow (get, list) Any user can read user profiles.
     * @allow (create, update, delete) Any user can modify user profiles.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to role definitions.
     * @path /roles/{roleId}
     * @allow (get, list) Any user can read role definitions.
     * @allow (create, update, delete) Any user can modify role definitions.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any user can read campaign information.
     * @allow (create, update, delete) Any user can modify campaign information.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to AI-generated campaign strategies.
     * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
     * @allow (get, list) Any user can read campaign strategies.
     * @allow (create, update, delete) Any user can modify campaign strategies.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to voter information.
     * @path /voters/{voterId}
     * @allow (get, list) Any user can read voter information.
     * @allow (create, update, delete) Any user can modify voter information.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to city information.
     * @path /cities/{cityId}
     * @allow (get, list) Any user can read city information.
     * @allow (create, update, delete) Any user can modify city information.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to campaign tasks.
     * @path /tasks/{taskId}
     * @allow (get, list) Any user can read campaign tasks.
     * @allow (create, update, delete) Any user can modify campaign tasks.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to call records for voters.
     * @path /calls/{callId}
     * @allow (get, list) Any user can read call records.
     * @allow (create, update, delete) Any user can modify call records.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to application branding settings.
     * @path /settings/branding
     * @allow (get, list) Any user can read branding settings.
     * @allow (create, update, delete) Any user can modify branding settings.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /settings/branding {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows read and write access to user-managed lists.
     * @path /lists/{listId}
     * @allow (get, list) Any user can read user-managed lists.
     * @allow (create, update, delete) Any user can modify user-managed lists.
     * @deny (none) This rule provides completely open access.
     * @principle Open access for prototyping.
     */
    match /lists/{listId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}