/**
 * @file Firestore Security Rules
 * @description This ruleset allows any authenticated user to read, create, edit, and delete any data.
 *
 * Core Philosophy:
 * The ruleset grants broad access to all authenticated users, allowing them to read and write data without restriction.
 *
 * Data Structure:
 * The Firestore database contains collections for users, roles, campaigns, voters, and cities.
 * Each collection stores documents representing the corresponding entity.
 *
 * Key Security Decisions:
 * This configuration does not enforce any access controls based on user roles, data ownership, or other criteria.
 * Any authenticated user can perform any operation on any document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete user profiles.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation.
     * @deny None.
     * @principle Allows any authenticated user to read, create, update, and delete user profiles.
     */
    match /users/{userId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete role definitions.
     * @path /roles/{roleId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation.
     * @deny None.
     * @principle Allows any authenticated user to read, create, update, and delete role definitions.
     */
    match /roles/{roleId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation.
     * @deny None.
     * @principle Allows any authenticated user to read, create, update, and delete campaign information.
     */
    match /campaigns/{campaignId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete voter information.
     * @path /voters/{voterId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation.
     * @deny None.
     * @principle Allows any authenticated user to read, create, update, and delete voter information.
     */
    match /voters/{voterId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read, create, update, and delete city information.
     * @path /cities/{cityId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation.
     * @deny None.
     * @principle Allows any authenticated user to read, create, update, and delete city information.
     */
    match /cities/{cityId} {
      allow get, list, create, update, delete: if isSignedIn();
    }
  }
}