/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a strict user-ownership model for user profiles and allows public read access to campaigns, roles, cities and voters.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles.  Access is restricted to the owning user.
 * - /roles/{roleId}: Stores role definitions. Read access is public, write access is denied.
 * - /campaigns/{campaignId}: Stores campaign information. Read access is public, write access is denied.
 * - /voters/{voterId}: Stores voter information. Read access is public, write access is denied.
 * - /cities/{cityId}: Stores city information. Read access is public, write access is denied.
 * - /calls/{callId}: Stores calls information. Read access is restricted to authenticated users, write access is denied.
 *
 * Key Security Decisions:
 * - User data is private and only accessible to the owning user.
 * - Listing of users is disallowed.
 * - All other collections are publicly readable.
 *
 * Denormalization for Authorization:
 *   N/A - User ownership is enforced via the userId in the path.
 *
 * Structural Segregation:
 *   N/A - No distinction between public and private data within a single collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure the users collection. Only the user themselves can read/write their own profile.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with UID matching the userId can create their profile.
     * @allow (get, update, delete) - Authenticated user with UID matching the userId can read/write their own profile.
     * @deny (create, get, update, delete) - Any other user attempting to access this profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure the roles collection.  Read access is public.  Write access is denied.
     * @path /roles/{roleId}
     * @allow (get, list) - Any user can read role definitions.
     * @deny (create, update, delete) - No one can create, update, or delete roles.
     * @principle Public read, owner-only writes with ownership field check.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure the campaigns collection.  Read access is public.  Write access is denied.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Any user can read campaign information.
     * @deny (create, update, delete) - No one can create, update, or delete campaigns.
     * @principle Public read, owner-only writes with ownership field check.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure the voters collection.  Read access is public.  Write access is denied.
     * @path /voters/{voterId}
     * @allow (get, list) - Any user can read voter information.
     * @deny (create, update, delete) - No one can create, update, or delete voters.
     * @principle Public read, owner-only writes with ownership field check.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Secure the cities collection.  Read access is public.  Write access is denied.
     * @path /cities/{cityId}
     * @allow (get, list) - Any user can read city information.
     * @deny (create, update, delete) - No one can create, update, or delete cities.
     * @principle Public read, owner-only writes with ownership field check.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    
    /**
     * @description Secures the calls collection.
     * @path /calls/{callId}
     * @allow (get, list) - Any authenticated user can read call information.
     * @deny (create, update, delete) - No one can create, update, or delete calls.
     * @principle Read only for authenticated users.
     */
    match /calls/{callId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow read: if isSignedIn();
      allow create, update, delete: if false; // Deny all write operations
    }
  }
}