/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure, owner-centric model for user data and employs role-based access control
 * for administrative functions. Data validation is relaxed in this prototyping phase to allow for rapid schema iteration.
 *
 * Data Structure:
 * - `/users/{userId}`: User profile information, accessible only to the user themselves.
 * - `/roles/{roleId}`: Role definitions (e.g., admin, campaign_manager, promoter).  Write access is restricted.
 * - `/campaigns/{campaignId}`: Campaign data.
 * - `/voters/{voterId}`: Voter information, accessible to authorized users.
 * - `/cities/{cityId}`: City data. Publicly readable.
 * - `/tasks/{taskId}`: Task data.
 * - `/calls/{callId}`: Call data.
 * - `/settings/branding`: Application-wide branding settings. Write access is restricted.
 * - `/lists/{listId}`: User-managed lists.
 * - `/campaigns/{campaignId}/generatedStrategies/{strategyId}`: AI-generated strategies for campaigns
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - The `cities` collection is publicly readable.
 * - Strict ownership is enforced for user profiles.
 * - Write access to `roles` and `settings/branding` is denied in this prototyping phase.
 *
 * Denormalization for Authorization:
 *  - The `Voter` entity has a `promoterId` field to associate it with a user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner and the resource exists.
     * @param {string} userId - The user ID to compare against the authenticated user's UID.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines access rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - User can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) - User can access/modify their own profile if authenticated.
     * @deny (list) - User listing is not allowed.
     * @deny (create) - User cannot create a user document that does not match their auth id.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, validates relational integrity between documents.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for roles.
     * @path /roles/{roleId}
     * @allow (get, list) - Anyone can read roles.
     * @deny (create, update, delete) - No one can create, update, or delete roles via client.
     * @principle Roles are read-only for clients in this phase.
     */
    match /roles/{roleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for campaigns.
     * @path /campaigns/{campaignId}
     * @allow (get, list) - Anyone can read campaign data.
     * @deny (create, update, delete) - No one can create, update, or delete campaigns.
     * @principle Campaigns are read-only for clients in this phase.
     */
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

     /**
      * @description Defines access rules for AI-generated campaign strategies.
      * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
      * @allow (get, list) - Anyone can read AI-generated strategies.
      * @deny (create, update, delete) - No one can create, update, or delete AI-generated strategies.
      * @principle Generated strategies are read-only for clients in this phase.
      */
    match /campaigns/{campaignId}/generatedStrategies/{strategyId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for voters.
     * @path /voters/{voterId}
     * @allow (get, list) - Anyone can read voters data.
     * @deny (create, update, delete) - No one can create, update, or delete voters via client.
     * @principle Voters are read-only for clients in this phase.
     */
    match /voters/{voterId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for cities.
     * @path /cities/{cityId}
     * @allow (get, list) - Anyone can read city data.
     * @deny (create, update, delete) - No one can create, update, or delete cities via client.
     * @principle Cities are publicly readable.
     */
    match /cities/{cityId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for tasks.
     * @path /tasks/{taskId}
     * @allow (get, list) - Anyone can read task data.
     * @deny (create, update, delete) - No one can create, update, or delete tasks via client.
     * @principle Tasks are read-only for clients in this phase.
     */
    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for calls.
     * @path /calls/{callId}
     * @allow (get, list) - Anyone can read call data.
     * @deny (create, update, delete) - No one can create, update, or delete calls via client.
     * @principle Calls are read-only for clients in this phase.
     */
    match /calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for branding settings.
     * @path /settings/branding
     * @allow (get) - Anyone can read branding settings.
     * @deny (create, update, delete, list) - No one can create, update, or delete branding settings via client.
     * @principle Branding settings are read-only for clients in this phase.
     */
    match /settings/branding {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Defines access rules for managed lists.
     * @path /lists/{listId}
     * @allow (get, list) - Anyone can read managed lists.
     * @deny (create, update, delete) - No one can create, update, or delete managed lists via client.
     * @principle Managed lists are read-only for clients in this phase.
     */
    match /lists/{listId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }
  }
}