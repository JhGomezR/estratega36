rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows access to branding settings. These settings are considered public.
     * @path /settings/branding
     * @allow (get, list) Any authenticated user can read branding settings.
     * @deny (create, update, delete) No one can create, update, or delete the branding settings via client.
     * @principle Allows public read access to non-sensitive configuration data.
     */
    match /settings/branding {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to user profiles.  Users can only manage their own profile.
     * @path /users/{userId}
     * @allow (get, list) The owner can read their own profile.
     * @allow (create) A user can create their own profile (self-registration).
     * @allow (update, delete) The owner can update or delete their own profile.
     * @deny Requests from other users or unauthenticated users.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && existsAfterUpdate();
      allow delete: if isOwner(userId) && existsAfterUpdate();
    }

    /**
     * @description Controls access to role definitions.  Roles are read-only and managed by admins (not implemented in this version).
     * @path /roles/{roleId}
     * @allow (get, list) Any authenticated user can read role definitions.
     * @deny (create, update, delete) No one can create, update, or delete roles via client.
     * @principle Restricts modification of roles to server-side logic.
     */
    match /roles/{roleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to campaign information.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any authenticated user can read campaign information.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete campaigns.
     * @principle Requires authentication for campaign modification.
     */
    match /campaigns/{campaignId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      /**
       * @description Controls access to AI-generated strategies for campaigns.
       * @path /campaigns/{campaignId}/generatedStrategies/{strategyId}
       * @allow (get, list) Any authenticated user can read campaign strategies.
       * @allow (create, update, delete) Only authenticated users can create, update, or delete campaign strategies.
       * @principle Requires authentication for campaign strategy modification.
       */
      match /generatedStrategies/{strategyId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    /**
     * @description Controls access to voter information.
     * @path /voters/{voterId}
     * @allow (get, list) Any authenticated user can read voter information.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete voters.
     * @principle Requires authentication for voter modification.
     */
    match /voters/{voterId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to city information.  City data is read-only.
     * @path /cities/{cityId}
     * @allow (get, list) Any authenticated user can read city information.
     * @deny (create, update, delete) No one can create, update, or delete cities via client.
     * @principle Restricts modification of city data to server-side logic.
     */
    match /cities/{cityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to campaign tasks.
     * @path /tasks/{taskId}
     * @allow (get, list) Any authenticated user can read task information.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete tasks.
     * @principle Requires authentication for task modification.
     */
    match /tasks/{taskId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to call records.
     * @path /calls/{callId}
     * @allow (get, list) Any authenticated user can read call records.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete calls.
     * @principle Requires authentication for call modification.
     */
    match /calls/{callId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to user-managed lists.
     * @path /lists/{listId}
     * @allow (get, list) Any authenticated user can read lists.
     * @allow (create, update, delete) Only authenticated users can create, update, or delete lists.
     */
    match /lists/{listId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
    }
   
        /**
         * Adding admin and super_admin claims for enhanced roles
         */
        function isAdmin() {
            return isSignedIn() && hasClaim('admin');
        }
        
        function isSuperAdmin() {
            return isSignedIn() && hasClaim('super_admin');
        }

        function hasClaim(claim) {
          return request.auth.token[claim] == true;
        }

    /**
     * @description Helper function to determine if the current user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Helper function to determine if the requested user ID matches the authenticated user's ID.
     * @param {string} userId The user ID from the path.
     * @return {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Helper function to determine if the requested user ID matches the authenticated user's ID and if the document exists.
      * @param {string} userId The user ID from the path.
      * @return {boolean} True if the user IDs match and the document exists, false otherwise.
      */
     function isExistingOwner(userId) {
       return isOwner(userId) && exists(getSelf().data);
     }
     
    function existsAfterUpdate() {
      return exists(resource.data);
    }
    
     function exists(data) {
        return data != null;
     }

     function getSelf() {
        return get(request.path);
     }
  }
}