/**
 * @file Firestore Security Rules
 * @description This ruleset defines the access control for the political campaign management application.
 *
 * Core Philosophy:
 * This ruleset prioritizes ease of data modification by all users, and maintains authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.  Access is restricted to authenticated users for reading and any user to writing.
 * - /roles/{roleId}: Stores role definitions. Allows any user to read and write role definitions.
 * - /campaigns/{campaignId}: Stores campaign information. Allows any user to read and write campaigns.
 * - /voters/{voterId}: Stores voter information.  Allows any user to read and write voter information.
 * - /cities/{cityId}: Stores city information. Allows any user to read and write city information.
 *
 * Key Security Decisions:
 * - The ruleset defaults to open access for write operations on most collections as per instructions.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get, list) Authenticated user can read their profile.
     * @allow (create, update, delete) Any authenticated user can modify their profile.
     * @deny  User attempts to modify another user's profile without being authenticated.
     * @principle Allows any authenticated user to write.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to role definition documents.
     * @path /roles/{roleId}
     * @allow (get, list) Any authenticated user can read role definitions.
     * @allow (create, update, delete) Any authenticated user can modify role definitions.
     * @deny  Unauthenticated user attempts to read or write role definitions.
     * @principle Open read and write access for any authenticated user.
     */
    match /roles/{roleId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to campaign documents.
     * @path /campaigns/{campaignId}
     * @allow (get, list) Any authenticated user can read campaign information.
     * @allow (create, update, delete) Any authenticated user can modify campaign information.
     * @deny  Unauthenticated user attempts to read or write campaign information.
     * @principle Open read and write access for any authenticated user.
     */
    match /campaigns/{campaignId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to voter documents.
     * @path /voters/{voterId}
     * @allow (get, list) Any authenticated user can read voter information.
     * @allow (create, update, delete) Any authenticated user can modify voter information.
     * @deny  Unauthenticated user attempts to read or write voter information.
     * @principle Open read and write access for any authenticated user.
     */
    match /voters/{voterId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to city documents.
     * @path /cities/{cityId}
     * @allow (get, list) Any authenticated user can read city information.
     * @allow (create, update, delete) Any authenticated user can modify city information.
     * @deny  Unauthenticated user attempts to read or write city information.
     * @principle Open read and write access for any authenticated user.
     */
    match /cities/{cityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}