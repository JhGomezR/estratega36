# Copia a .env (o configura estas variables en el panel del proveedor).
# NO subas .env ni claves a git.

# ---- Traefik (proxy + HTTPS ya presente en el server) ----
# Dominio público de la app (DNS apuntando al server).
APP_DOMAIN=app.tudominio.com
# Nombre REAL de la red de Traefik. Obtenlo con: docker network ls
# (suele llevar prefijo de proyecto, ej. root_traefik_net). CRÍTICO: si no
# coincide, el contenedor no se crea ("0 container").
TRAEFIK_NETWORK=traefik_net
# Entrypoint HTTPS de tu Traefik (normalmente "websecure").
TRAEFIK_ENTRYPOINT=websecure
# Certresolver configurado en tu Traefik (ej. "letsencrypt").
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- App ----
# Genkit / Google AI
GEMINI_API_KEY=
# Google Maps (se hornea en build)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Firebase Admin SDK: JSON completo del service-account en UNA sola línea.
# Ej: FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
FIREBASE_SERVICE_ACCOUNT_KEY=
