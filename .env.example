# Copia este archivo a .env (o configura estas variables en el panel del
# proveedor). NO subas .env ni la clave de servicio a git.

# Puerto del host donde se publica la app (la plataforma enruta el dominio aquí).
# NO uses 80/443: los gestiona la plataforma (Hostinger, etc.).
APP_PORT=8080

# Google AI / Genkit
GEMINI_API_KEY=

# Google Maps — se hornea en tiempo de build (NEXT_PUBLIC_*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Admin SDK: pega el CONTENIDO del service-account.json en UNA sola
# línea (JSON completo). La app lo lee de esta variable; no se monta archivo.
# Ejemplo: FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
FIREBASE_SERVICE_ACCOUNT_KEY=
