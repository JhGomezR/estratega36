# Copia este archivo a .env y rellena los valores. NO subas .env a git.

# Dominio público para HTTPS automático (Let's Encrypt).
# Para pruebas locales usa: APP_DOMAIN=localhost
APP_DOMAIN=tudominio.com

# Google AI / Genkit
GEMINI_API_KEY=

# Google Maps — se hornea en tiempo de build (NEXT_PUBLIC_*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Admin SDK:
# Coloca el archivo de la cuenta de servicio como  service-account.json  en la
# raíz del proyecto. docker-compose lo monta en /run/secrets/service-account.json
# y la app lo usa vía GOOGLE_APPLICATION_CREDENTIALS (configurado en el compose).
