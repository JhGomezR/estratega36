# Copia este archivo a .env (o configura estas variables en el panel del
# proveedor). NO subas .env ni la clave de servicio a git.

# ---- Enrutamiento por Traefik (ya instalado en el server) ----
# Dominio público que servirá la app.
APP_DOMAIN=app.tudominio.com
# Red docker EXTERNA donde corre Traefik. Descúbrela con:
#   docker inspect root-traefik-1 --format "{{json .NetworkSettings.Networks}}"
# Suele ser algo como "root_default", "traefik" o "proxy".
TRAEFIK_NETWORK=root_default
# Entrypoint HTTPS de tu Traefik (normalmente "websecure").
TRAEFIK_ENTRYPOINT=websecure
# Nombre del certresolver configurado en tu Traefik (ej. "letsencrypt", "le").
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- App ----
# Google AI / Genkit
GEMINI_API_KEY=
# Google Maps — se hornea en tiempo de build (NEXT_PUBLIC_*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Firebase Admin SDK: JSON completo del service-account en UNA sola línea.
# Ejemplo: FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
FIREBASE_SERVICE_ACCOUNT_KEY=
